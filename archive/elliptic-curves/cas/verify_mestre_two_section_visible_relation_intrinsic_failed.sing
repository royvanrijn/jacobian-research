// ARCHIVED FAILED EXPERIMENT: denominator-cleared covariant reduction stopped.
// Characteristic-zero visible-dependence certificate in intrinsic coordinates.
//
// Put a=r3, b=r4, s=r5+r6 and z=r5.  Eliminating p=r5*r6 from the sparse
// incidence equation gives p below; the selected Mestre factor is the quartic
// F(a,b,s).  Thus F=0 together with z(s-z)=p is the degree-eight labelled
// component over Q(a,b).  The first ring reconstructs the Mestre quartic and
// cubic ordinates with T polynomial.  The second treats T,a,b as parameters
// and checks the L(6O) divisor determinant in the finite component algebra.

option(redSB);
ring IntrinsicPolynomial = (0,a,b),(T,X,s,z,id),dp;

proc coefficientIn(poly f, poly variable, int exponent)
{
  int index;
  int factorial = 1;
  for (index=1; index<=exponent; index=index+1)
  {
    f = diff(f,variable);
    factorial = factorial*index;
  }
  return(subst(f,variable,0)/factorial);
}

number e = a-b+1;
poly p =
  (s-b)*(-a^2+a*b+a*s-a-b*s+b+s-1)/e;
poly F =
  -a^5+2*a^4*b+a^4*s-a^4+3*a^3*b^2-10*a^3*b*s
  +4*a^3*s^2+2*a^3-3*a^2*b^3+9*a^2*b^2+11*a^2*b*s^2
  -14*a^2*b*s-4*a^2*b-7*a^2*s^3+8*a^2*s^2-2*a^2*s
  +2*a^2-2*a*b^4+10*a*b^3*s-6*a*b^3-11*a*b^2*s^2
  +9*a*b^2+14*a*b*s^2-14*a*b*s+3*a*s^4-10*a*s^3
  +8*a*s^2-a+b^5-b^4*s-2*b^4-4*b^3*s^2+10*b^3*s
  -3*b^3+7*b^2*s^3-11*b^2*s^2+3*b^2-3*b*s^4
  +11*b*s^2-10*b*s+2*b+3*s^4-7*s^3+4*s^2+s-1;
poly d = a-s+1;
ideal intrinsicIdeal = F,z*(s-z)-p,d*id-1;
ideal intrinsicBasis = std(intrinsicIdeal);

proc nfProduct(poly left, poly right)
{
  return(reduce(left*right,intrinsicBasis));
}

poly q = X*(X-1)*(X-a)*(X-b)*(X-z)*(X-(s-z));
poly a1 = coefficientIn(q,X,5);
poly a2 = coefficientIn(q,X,4);
poly a3 = coefficientIn(q,X,3);
poly a4 = coefficientIn(q,X,2);
poly a5 = coefficientIn(q,X,1);
poly M =
  a1^5-6*a1^3*a2+7*a1^2*a3+8*a1*a2^2
  -8*a1*a4-12*a2*a3+24*a5;
poly D = 5*a1^4-24*a1^2*a2+32*a1*a3+16*a2^2-64*a4;
poly Hcleared =
  a*d+e*d*(s-b)-e*(a-p);
if (reduce(M,intrinsicBasis) != 0 || reduce(Hcleared,intrinsicBasis) != 0)
{
  "ERROR: intrinsic surface does not imply M=H=0";
  exit(2);
}

poly splitA = 3*a^2-3*b^2-6*a+3;
poly splitB =
  -a^4+6*a^3*b-7*a^2*b^2+6*a*b^3-b^4
  -8*a^3-6*a^2*b+2*a*b^2+6*b^3
  +18*a^2-6*a*b-7*b^2-8*a+6*b-1;
poly splitC =
  12*a^4*b^2-12*a^2*b^4-48*a^3*b^2+24*a*b^4
  +72*a^2*b^2-12*b^4-48*a*b^2+12*b^2;
poly splitE =
  -144*a^4*b^3+144*a^3*b^4+144*a^4*b^2
  +144*a^3*b^3-288*a^2*b^4-288*a^3*b^2
  +144*a^2*b^3+144*a*b^4+144*a^2*b^2-144*a*b^3;
poly splitNumerator = reduce(
  -nfProduct(D,D)-nfProduct(splitB,D)-splitE,intrinsicBasis
);
poly splitDenominator = reduce(nfProduct(splitA,D)+splitC,intrinsicBasis);
if (reduce(
  nfProduct(splitNumerator,splitNumerator)
  -nfProduct(D,nfProduct(splitDenominator,splitDenominator)),
  intrinsicBasis
) != 0)
{
  "ERROR: intrinsic leading square identity failed";
  exit(2);
}

poly productShifted = subst(q,X,X-T)*subst(q,X,X+T);
poly g = X^6;
int lowerDegree;
int targetDegree;
poly correction;
for (lowerDegree=5; lowerDegree>=0; lowerDegree=lowerDegree-1)
{
  targetDegree = 6+lowerDegree;
  correction =
    (coefficientIn(productShifted,X,targetDegree)
     -coefficientIn(g*g,X,targetDegree))/2;
  correction = reduce(correction,intrinsicBasis);
  g = reduce(g+correction*X^lowerDegree,intrinsicBasis);
}
poly numeratorR = reduce(g*g-productShifted,intrinsicBasis);
poly R = numeratorR/T^2;
if (numeratorR-T^2*R != 0)
{
  "ERROR: recursive remainder is not divisible by T^2";
  exit(2);
}

poly x01 = a/e;
poly x11 = (2*z-s)/e;
poly x02 = reduce((a-p)*id,intrinsicBasis);
poly x12 = reduce(-b*id,intrinsicBasis);
poly sectionValue1 = reduce(subst(R,X,x01+x11*T),intrinsicBasis);
poly sectionValue2 = reduce(subst(R,X,x02+x12*T),intrinsicBasis);

string savedF = string(F);
string savedP = string(p);
string savedD = string(D);
string savedSplitA = string(splitA);
string savedSplitB = string(splitB);
string savedSplitC = string(splitC);
string savedSplitE = string(splitE);
string savedQuarticE = string(coefficientIn(R,X,0));
string savedQuarticD = string(coefficientIn(R,X,1));
string savedQuarticC = string(coefficientIn(R,X,2));
string savedQuarticB = string(coefficientIn(R,X,3));
string savedQuarticA = string(coefficientIn(R,X,4));
string savedF13 = string(coefficientIn(sectionValue1,T,3));
string savedF14 = string(coefficientIn(sectionValue1,T,4));
string savedF15 = string(coefficientIn(sectionValue1,T,5));
string savedF23 = string(coefficientIn(sectionValue2,T,3));
string savedF24 = string(coefficientIn(sectionValue2,T,4));
string savedF25 = string(coefficientIn(sectionValue2,T,5));
string savedVisible0PlusY = string(reduce(subst(g,X,T),intrinsicBasis));
string savedVisible4MinusY = string(reduce(subst(g,X,b-T),intrinsicBasis));
string savedVisible5PlusY = string(reduce(subst(g,X,z+T),intrinsicBasis));
string savedVisible6MinusY = string(
  reduce(subst(g,X,s-z-T),intrinsicBasis)
);

ring IntrinsicFunctionField = (0,T,a,b),(s,z,id),dp;
execute("poly F="+savedF+";");
execute("poly p="+savedP+";");
execute("poly D="+savedD+";");
execute("poly splitA="+savedSplitA+";");
execute("poly splitB="+savedSplitB+";");
execute("poly splitC="+savedSplitC+";");
execute("poly splitE="+savedSplitE+";");
execute("poly quarticE="+savedQuarticE+";");
execute("poly quarticD="+savedQuarticD+";");
execute("poly quarticC="+savedQuarticC+";");
execute("poly quarticB="+savedQuarticB+";");
execute("poly quarticA="+savedQuarticA+";");
execute("poly f13="+savedF13+";");
execute("poly f14="+savedF14+";");
execute("poly f15="+savedF15+";");
execute("poly f23="+savedF23+";");
execute("poly f24="+savedF24+";");
execute("poly f25="+savedF25+";");
execute("poly visible0PlusY="+savedVisible0PlusY+";");
execute("poly visible4MinusY="+savedVisible4MinusY+";");
execute("poly visible5PlusY="+savedVisible5PlusY+";");
execute("poly visible6MinusY="+savedVisible6MinusY+";");

number e = a-b+1;
poly d = a-s+1;
ideal componentIdeal = F,z*(s-z)-p,d*id-1;
ideal componentBasis = std(componentIdeal);

proc nfProduct(poly left, poly right)
{
  return(reduce(left*right,componentBasis));
}

proc nfSquare(poly value)
{
  return(nfProduct(value,value));
}

proc nfPower(poly value, int exponent)
{
  poly answer = 1;
  int index;
  for (index=1; index<=exponent; index=index+1)
  {
    answer = nfProduct(answer,value);
  }
  return(answer);
}

poly splitNumerator = reduce(
  -nfSquare(D)-nfProduct(splitB,D)-splitE,componentBasis
);
poly splitDenominator = reduce(nfProduct(splitA,D)+splitC,componentBasis);
poly x01 = a/e;
poly x11 = (2*z-s)/e;
poly x02 = reduce((a-p)*id,componentBasis);
poly x12 = reduce(-b*id,componentBasis);

proc nonvisibleOrdinate(poly slope, poly f3, poly f4, poly f5)
{
  poly Sn = nfProduct(1-nfSquare(slope),splitNumerator);
  poly Sd = 2*splitDenominator;
  poly Sn2 = nfSquare(Sn);
  poly Sn3 = nfProduct(Sn2,Sn);
  poly Sn4 = nfSquare(Sn2);
  poly Sn5 = nfProduct(Sn4,Sn);
  poly Sn6 = nfSquare(Sn3);
  poly Sd2 = nfSquare(Sd);
  poly N1n = reduce(
    4*nfProduct(Sn2,f4)-nfProduct(nfSquare(f5),Sd2),componentBasis
  );
  poly N0n = reduce(
    8*nfProduct(Sn4,f3)-nfProduct(nfProduct(N1n,f5),Sd2),
    componentBasis
  );
  poly yNumerator = reduce(
    nfProduct(N0n,Sd2)+2*T*nfProduct(nfProduct(N1n,Sn2),Sd2)
    +8*T^2*nfProduct(nfProduct(f5,Sn4),Sd2)+16*T^3*Sn6,
    componentBasis
  );
  poly yDenominator = reduce(16*nfProduct(Sn5,Sd),componentBasis);
  return(ideal(yNumerator,yDenominator));
}

poly covariantG0 = reduce(
  nfSquare(quarticB)/16-nfProduct(quarticA,quarticC)/6,componentBasis
);
poly covariantG1 = reduce(
  nfProduct(quarticB,quarticC)/12-nfProduct(quarticA,quarticD)/2,
  componentBasis
);
poly covariantG2 = reduce(
  nfSquare(quarticC)/12-nfProduct(quarticB,quarticD)/8
  -nfProduct(quarticA,quarticE),componentBasis
);
poly covariantG3 = reduce(
  nfProduct(quarticC,quarticD)/12-nfProduct(quarticB,quarticE)/2,
  componentBasis
);
poly covariantG4 = reduce(
  nfSquare(quarticD)/16-nfProduct(quarticC,quarticE)/6,componentBasis
);

proc covariantPoint(poly xValue, poly yNumerator, poly yDenominator)
{
  poly x2 = nfSquare(xValue);
  poly x3 = nfProduct(x2,xValue);
  poly x4 = nfSquare(x2);
  poly gv = reduce(
    covariantG0*x4+covariantG1*x3+covariantG2*x2
    +covariantG3*xValue+covariantG4,componentBasis
  );
  poly gx = reduce(
    4*covariantG0*x3+3*covariantG1*x2
    +2*covariantG2*xValue+covariantG3,componentBasis
  );
  poly gy = reduce(
    covariantG1*x3+2*covariantG2*x2
    +3*covariantG3*xValue+4*covariantG4,componentBasis
  );
  poly ux = reduce(
    4*quarticA*x3+3*quarticB*x2+2*quarticC*xValue+quarticD,
    componentBasis
  );
  poly uy = reduce(
    quarticB*x3+2*quarticC*x2+3*quarticD*xValue+4*quarticE,
    componentBasis
  );
  poly hv = reduce((nfProduct(ux,gy)-nfProduct(uy,gx))/8,componentBasis);
  poly denominator2 = nfSquare(yDenominator);
  poly denominator3 = nfProduct(denominator2,yDenominator);
  return(ideal(
    36*nfProduct(gv,denominator2),
    108*nfProduct(hv,denominator3),
    yNumerator
  ));
}

ideal ordinate1 = nonvisibleOrdinate(x11,f13,f14,f15);
ideal ordinate2 = nonvisibleOrdinate(x12,f23,f24,f25);
"nonvisible_ordinates_constructed",1;
ideal point1 = covariantPoint(x01+x11*T,ordinate1[1],ordinate1[2]);
ideal point2 = covariantPoint(x02+x12*T,ordinate2[1],ordinate2[2]);
"nonvisible_covariant_points_constructed",1;
ideal visible0plus = covariantPoint(T,visible0PlusY,T);
ideal visible4minus = covariantPoint(b-T,visible4MinusY,T);
ideal visible5plus = covariantPoint(z+T,visible5PlusY,T);
ideal visible6minus = covariantPoint(s-z-T,visible6MinusY,T);
"visible_support_constructed",1;

ideal relationPoints =
  point2[1],point2[2],point2[3],
  point1[1],-point1[2],point1[3],
  visible0plus[1],-visible0plus[2],visible0plus[3],
  visible4minus[1],-visible4minus[2],visible4minus[3],
  visible5plus[1],-visible5plus[2],visible5plus[3],
  visible6minus[1],-visible6minus[2],visible6minus[3];

matrix relationMatrix[6][6];
int rowIndex;
int offset;
poly rowX;
poly rowY;
poly rowZ;
for (rowIndex=1; rowIndex<=6; rowIndex=rowIndex+1)
{
  offset = 3*(rowIndex-1);
  rowX = relationPoints[offset+1];
  rowY = relationPoints[offset+2];
  rowZ = relationPoints[offset+3];
  relationMatrix[rowIndex,1] = nfPower(rowZ,6);
  relationMatrix[rowIndex,2] = nfProduct(rowX,nfPower(rowZ,4));
  relationMatrix[rowIndex,3] = nfProduct(rowY,nfPower(rowZ,3));
  relationMatrix[rowIndex,4] = nfProduct(nfSquare(rowX),nfSquare(rowZ));
  relationMatrix[rowIndex,5] = nfProduct(nfProduct(rowX,rowY),rowZ);
  relationMatrix[rowIndex,6] = nfPower(rowX,3);
}
"riemann_roch_matrix_constructed",1;

proc nfDeterminant(matrix inputMatrix)
{
  int matrixSize = nrows(inputMatrix);
  if (matrixSize == 1)
  {
    return(reduce(inputMatrix[1,1],componentBasis));
  }
  poly answer = 0;
  int expansionColumn;
  int sourceRow;
  int sourceColumn;
  int targetRow;
  int targetColumn;
  poly term;
  for (expansionColumn=1; expansionColumn<=matrixSize;
       expansionColumn=expansionColumn+1)
  {
    matrix submatrix[matrixSize-1][matrixSize-1];
    targetRow = 1;
    for (sourceRow=2; sourceRow<=matrixSize; sourceRow=sourceRow+1)
    {
      targetColumn = 1;
      for (sourceColumn=1; sourceColumn<=matrixSize;
           sourceColumn=sourceColumn+1)
      {
        if (sourceColumn != expansionColumn)
        {
          submatrix[targetRow,targetColumn] = inputMatrix[sourceRow,sourceColumn];
          targetColumn = targetColumn+1;
        }
      }
      targetRow = targetRow+1;
    }
    term = nfProduct(
      inputMatrix[1,expansionColumn],nfDeterminant(submatrix)
    );
    if (expansionColumn % 2 == 1)
    {
      answer = reduce(answer+term,componentBasis);
    }
    else
    {
      answer = reduce(answer-term,componentBasis);
    }
  }
  return(answer);
}

poly relationDeterminant = nfDeterminant(relationMatrix);

"MESTRE_TWO_SECTION_VISIBLE_RELATION_INTRINSIC_V1";
"component_degree_over_Qab",vdim(componentBasis);
"relation","P2=P1+V(0,+)+V(r4,-)+V(r5,+)+V(r6,-)";
"riemann_roch_determinant_zero",relationDeterminant == 0;
"DONE";
