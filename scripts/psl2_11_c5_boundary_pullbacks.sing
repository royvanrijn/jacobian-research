// Exact affine boundary components and normalized node branches for C5.
LIB "primdec.lib";

ring R=(0,r),(x,y,m),lp;
minpoly=r^2+11;

poly f=x5+(-1/2*r+1/2)*x4*y-x3*y2+x2*y3
 +(-1/2*r-1/2)*x*y4-y5+(-1/2*r+11/2)*x4-2*r*x3*y
 -2*r*x*y3+(-1/2*r-11/2)*y4+(16*r+11)*x3
 +(3/2*r+99/2)*x2*y+(3/2*r-99/2)*x*y2+(16*r-11)*y3
 +(165/2*r-473/2)*x2+176*r*x*y+(165/2*r+473/2)*y2
 +(605*r-1430)*x+(605*r+1430)*y-550*r;

poly p1x=2*x+11-3*r;
poly p2x=2*x2-(11-3*r)*x-(22+6*r);
poly p3x=x2+11*x+55+9*r;
poly q1x=2*x+5+3*r;
poly q2x=2*x3+(15-3*r)*x2-(12-12*r)*x+56+96*r;
poly q3x=2*x3-18*x2+(21+45*r)*x-(175+279*r);
poly p1y=2*y+11+3*r;
poly p2y=2*y2-(11+3*r)*y-(22-6*r);
poly p3y=y2+11*y+55-9*r;
poly q1y=2*y+5-3*r;
poly q2y=2*y3+(15+3*r)*y2-(12+12*r)*y+56-96*r;
poly q3y=2*y3-18*y2+(21-45*r)*y-(175-279*r);

proc showfiber(poly s,string label)
{
  ideal J=std(radical(ideal(f,s)));
  list L=minAssGTZ(J);
  int i;
  for(i=1;i<=size(L);i++)
  {
    print(label+"_"+string(i)+" degree="
      +string(vdim(std(L[i]+ideal(m)))));
    print(std(L[i]));
  }
}

showfiber(p1x,"p1");
showfiber(p2x,"p2");
showfiber(p3x,"p3");
showfiber(q1x,"q1");
showfiber(q2x,"q2");
showfiber(q3x,"q3");

proc expectplane(poly sx,poly sy,int d,string label)
{
  ideal J=std(radical(ideal(f,sx,sy,m)));
  if(vdim(J)!=d)
  {
    print("FAIL "+label+" plane boundary degree");
    exit(1);
  }
}

expectplane(p1x,p1y,1,"p1_p1");
expectplane(p1x,p2y,2,"p1_p2");
expectplane(p2x,p1y,2,"p2_p1");
expectplane(p2x,p2y,4,"p2_p2");
expectplane(p2x,p3y,2,"p2_p3");
expectplane(p3x,p2y,2,"p3_p2");
expectplane(p3x,p3y,4,"p3_p3");
expectplane(q1x,q1y,1,"q1_q1");
expectplane(q1x,q2y,3,"q1_q2");
expectplane(q2x,q1y,3,"q2_q1");
expectplane(q2x,q2y,6,"q2_q2");
expectplane(q2x,q3y,6,"q2_q3");
expectplane(q3x,q2y,6,"q3_q2");
expectplane(q3x,q3y,3,"q3_q3");

poly tangent=diff(diff(f,x),x)+2*diff(diff(f,x),y)*m
 +diff(diff(f,y),y)*m2;

proc shownode(ideal I,string label,int d)
{
  ideal T=std(I+ideal(tangent));
  list L=minAssGTZ(T);
  int i;
  if(size(L)!=1 || vdim(std(L[1]))!=d)
  {
    print("FAIL "+label+" normalized branch prime");
    exit(1);
  }
  for(i=1;i<=size(L);i++)
  {
    print(label+"_"+string(i)+" degree="+string(vdim(std(L[i]))));
    print(std(L[i]));
  }
}

ideal I=ideal(p2x,2*y+11+3*r);
shownode(I,"p2_p1_node",4);
I=ideal(p1x,2*y2-(11+3*r)*y-(22-6*r));
shownode(I,"p1_p2_node",4);
I=ideal(q1x,2*y+5-3*r);
shownode(I,"q1_q1_node",2);

print("PASS exact C5 boundary ideals determine both projection pullbacks");
