// Verify the geometric genus of the corrected A4 selector boundary.

ring root_ring=0,(T,a,b),dp;

poly rho=b^2+3*b+9;
poly B=
    a^3-3*a*b^2+2*b^3-9*a*b+9*b^2-27*a+27*b+27;
poly A=a^3-b^3-9*b^2-27*b-54;
poly C=a^3-b^3+27;
poly P=
    T^4
    -6*A*B*T^2
    -8*B^3*T
    +B^2*(9*A^2-12*C*B);
poly c=2*b+3;
poly Hhat=
    4*c*(2*T-(27-3*c)*rho)
    -27*(c-9)*a*rho;
poly chi=16*a^2-8*a*b-12*a+rho;
poly Lchi=
    (32*a+9-4*c)*T
    -13311*a^3
    +(2241*c-567)*a^2
    +(162*c-7290)*a;

poly selector_norm=resultant(P,Hhat,T);
poly curvette_norm=resultant(P,Lchi,T);

ring coefficient_ring=0,(a,b),dp;
poly selector_norm=imap(root_ring,selector_norm);
poly chi=imap(root_ring,chi);
poly curvette_norm=imap(root_ring,curvette_norm);
poly q14=curvette_norm/chi;

if (deg(selector_norm)!=16)
{
    ERROR("the corrected-selector norm does not have degree 16");
}
if (reduce(curvette_norm,std(ideal(chi)))!=0 || deg(q14)!=14)
{
    ERROR("the curvette norm is not chi times a degree-14 polynomial");
}

LIB "normal.lib";
int selector_genus=genus(ideal(selector_norm));
int q14_genus=genus(ideal(q14));

if (selector_genus!=13)
{
    ERROR("the corrected-selector norm does not have geometric genus 13");
}
if (q14_genus!=20)
{
    ERROR("the degree-14 curvette complement does not have geometric genus 20");
}

print("PASS: the corrected-selector norm has degree 16");
print("PASS: its projective normalization has geometric genus 13");
print("PASS: Norm(Lchi)=chi*q14 with q14 of degree 14");
print("PASS: the projective normalization of q14 has geometric genus 20");
print("OBSTRUCTION: the B-free boundary complement is not an affine plane");
