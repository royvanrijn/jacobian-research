// Independent Singular audit of the generic degree-six quadratic gauge.
// Coefficients g1,...,g6 are algebraically independent over Q; in particular
// g1 and g3 are units in the rational function coefficient field.

ring r = (0,g1,g2,g3,g4,g5,g6),(x,y,z),dp;

poly t = 1 + x*y;
poly q = t^2*z + (g1/g3)*y^2*(1 + 3*t);

poly F1 = t*q;
poly F2 = y
  + 3*(g3/g1)*x*q
  + 2*(g2/g1)*t*q
  + 4*(g4/g1)*t^2*x^2*q^4
  + 5*(g5/g1)*t^2*x^3*q^5
  + 6*(g6/g1)*t^2*x^4*q^6;
poly F3 = x*(5 - 3*t)
  - (g3/g1)*x^3*z
  - 2*(g4/g1)*(x*q)^4
  - 3*(g5/g1)*(x*q)^5
  - 4*(g6/g1)*(x*q)^6;

ideal F = F1,F2,F3;
matrix J = jacob(F);
poly determinant = det(J);

if (determinant + 2 != 0)
{
  "FAIL: generic degree-six Jacobian is not -2";
  determinant;
  exit(1);
}

if (deg(F1) > 7)
{
  "FAIL: first coordinate exceeds degree 7";
  deg(F1);
  exit(1);
}

if (deg(F2) > 38)
{
  "FAIL: second coordinate exceeds 6N+2 for N=6";
  deg(F2);
  exit(1);
}

if (deg(F3) > 36)
{
  "FAIL: third coordinate exceeds 6N for N=6";
  deg(F3);
  exit(1);
}

"PASS: Singular generic degree-six Jacobian is -2";
"PASS: Singular degree profile satisfies (7, 38, 36) upper bounds";
exit(0);
