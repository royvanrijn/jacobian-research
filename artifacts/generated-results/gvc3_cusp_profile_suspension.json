    "ladder": "Delta^(Nm+ell)(x^(2ell)*P^m)=2^(Nm+ell)*(Nm+ell)!*(2Nm+2ell+1)!!*binom(rm-1,ell-1)*c_m",
    "terminal_trace": "d_y^2*Delta^(Nm-1)(P^m)=2^(Nm-3)*(Nm-1)!*(2Nm+3)!!*c_m",
    "shifted_power_detector": "Delta^((N-1)d)*d_y^(2d)*Lambda^m(P^(m+d))=2^(Nm+(N-3)d)*(Nm+(N-1)d)!*(2Nm+2(N+1)d+1)!!*binom(r(m+d)-1,d-1)*c_(m+d)"
  },
  "cusp_geometry": {
    "U": "rho=t^2+x*y",
    "V": "t*(rho+x^2)",
    "identity": "V^2-U^3=-x*C",
    "x_zero_normalization": "(U,V)=(t^2,t^3)"
  },
