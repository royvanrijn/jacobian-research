/elkies-k3/sphere-packing/

# Sage generated Python
**/*.sage.py

# Python cache
**/__pycache__/
**/*.py[cod]

# Bazel generated trees/symlinks
**/bazel-bin/
**/bazel-out/
**/bazel-testlogs/
**/bazel-*/

