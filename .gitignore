# macOS and editor-local files
.DS_Store
.singularhistory
*.swp
*.swo
*~
.vscode/
.idea/

# Python environments, caches, and tooling state
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

# Reproducible verification logs are generated locally and uploaded by CI.
artifacts/verification/

# Resumable heavyweight certificate material is a local generation cache.
# Pinned, compact reference artifacts remain in artifacts/generated-results/.
/artifacts/local/

# Paper-local LaTeX build products
/papers/**/*.aux
/papers/**/*.log
/papers/**/*.fls
/papers/**/*.fdb_latexmk
/papers/**/*.out
/papers/**/*.toc
/papers/**/*.bbl
/papers/**/*.blg
/papers/**/main.pdf

# arXiv upload copies intentionally include their precompiled bibliographies.
!/papers/**/arxiv-upload/
!/papers/**/arxiv-upload/main.bbl

.lake/

# Julia local environment products
.julia/

tmp/

# ----------------------------------------------------------------------
# Elkies K3 research - transient / reproducible search material
# ----------------------------------------------------------------------

/elkies-k3/runs/
/elkies-k3/logs/
/elkies-k3/snapshots/
/elkies-k3/checkpoints/
/elkies-k3/archive-hunt/
/elkies-k3/niemeier-all/

# Separate sphere-packing working checkout.
# Relevant modifications are preserved under elkies-k3/provenance/.
/elkies-k3/sphere-packing/

# Sage generated Python
**/*.sage.py

# Python cache
**/__pycache__/
**/*.py[cod]

# Bazel generated trees/symlinks
**/bazel-bin/
**/bazel-out/
**/bazel-testlogs/
**/bazel-*/

# Large generated Elkies-K3 numerical artifacts
elkies-k3/results/**/*.npy
elkies-k3/results/**/*.sqlite
