poly f3=h*b3+a3*N;
poly a4=(7+30*w+56*w^2+12*w^3+65*w^4)*h^3+(7+9*w+4*w^2+39*w^3+10*w^4)*h^2+(54+5*w+69*w^2+31*w^3+16*w^4)*h*u2+(29+19*w+51*w^2+50*w^3+44*w^4)*h+(7+35*w+32*w^2+19*w^3+21*w^4)*u1+(4+34*w+57*w^2+43*w^3+62*w^4)*u2+5+34*w+16*w^2+7*w^3+16*w^4;
poly b4=(47+41*w+w^2+46*w^3+21*w^4)*h^7+(41+70*w+33*w^2+45*w^3+28*w^4)*h^6+(55+38*w+19*w^2+70*w^3+43*w^4)*h^5*u2+(58+52*w^2+64*w^3+31*w^4)*h^5+(14+7*w+58*w^2+51*w^3+29*w^4)*h^4*u1+(3+33*w+18*w^2+8*w^3+28*w^4)*h^4*u2+(49+9*w+65*w^2+31*w^3+30*w^4)*h^3*u2^2+(21+18*w+20*w^2+39*w^3+39*w^4)*h^4+(60+43*w+22*w^2+69*w^3+61*w^4)*h^3*u1+(57*w+22*w^2+45*w^3+65*w^4)*h^3*u2+(17+54*w^2+42*w^3+25*w^4)*h^2*u1*u2+(38+25*w+59*w^2+21*w^3+7*w^4)*h^2*u2^2+(65+65*w+39*w^2+8*w^3+44*w^4)*h*u2^3+(33+25*w+11*w^2+57*w^3+38*w^4)*h^3+(39+42*w+13*w^2+67*w^3+31*w^4)*h^2*u1+(4+23*w+56*w^3+23*w^4)*h^2*u2+(4+11*w+4*w^2+28*w^3+56*w^4)*h*u1^2+(46+33*w+20*w^2+43*w^3+11*w^4)*h*u1*u2+(45+51*w+31*w^2+37*w^3+53*w^4)*h*u2^2+(56*w+47*w^2+45*w^3+64*w^4)*u1*u2^2+(46+54*w+16*w^2+11*w^3+54*w^4)*u2^3+(23+54*w+50*w^2+61*w^3+60*w^4)*h^2+(5+64*w+44*w^2+44*w^3+7*w^4)*h*u1+(5+30*w+53*w^2+36*w^3+17*w^4)*h*u2+(35+66*w+41*w^2+33*w^3+40*w^4)*u1^2+(33+42*w+24*w^2+41*w^3+44*w^4)*u1*u2+(28+34*w+44*w^2+68*w^3+17*w^4)*u2^2+(15+w+17*w^2+9*w^3+33*w^4)*h+(20+2*w+25*w^2+17*w^3+51*w^4)*u1+(23+8*w+69*w^2+68*w^3+58*w^4)*u2+35+8*w+61*w^2+70*w^3+69*w^4;
poly f4=h*b4+a4*N;
poly m12=a1*b2-a2*b1;
poly m13=a1*b3-a3*b1;
poly m14=a1*b4-a4*b1;
poly m23=a2*b3-a3*b2;
poly m24=a2*b4-a4*b2;
poly m34=a3*b4-a4*b3;
ideal M=m12,m13,m14,m23,m24,m34;
ideal FI=f1,f2,f3,f4;
proc testunit(string name, ideal K){ ideal G=std(K); print(name+"|SIZE="+string(size(G))); if(size(G)==1 && G[1]==1){print(name+"|UNIT");}else{print(name+"|NONUNIT"); print(name+"|VDIM="+string(vdim(G)));}}
testunit("M",M);
testunit("M_H",M,h);
testunit("M_N",M,N);
testunit("M_HN",M,h,N);
testunit("M_F1",M,f1);
testunit("M_F12",M,f1,f2);
testunit("M_F123",M,f1,f2,f3);
testunit("M_FI",M,FI);
testunit("FI",FI);
ring S=(71,w),(h,u1,u2,z),dp;
minpoly=w^5-w^4+3*w^3+3*w^2+26;
ideal Ms=imap(R,M); poly Ns=imap(R,N); poly f1s=imap(R,f1); poly f2s=imap(R,f2); poly f3s=imap(R,f3); poly f4s=imap(R,f4);
proc testunits(string name, ideal K){ ideal G=std(K); print(name+"|SIZE="+string(size(G))); if(size(G)==1 && G[1]==1){print(name+"|UNIT");}else{print(name+"|NONUNIT");}}
testunits("MHINV",Ms,z*h-1);
testunits("MF1HINV",Ms,f1s,z*h-1);
testunits("MF12HINV",Ms,f1s,f2s,z*h-1);
testunits("MFIHINV",Ms,f1s,f2s,f3s,f4s,z*h-1);
quit;
