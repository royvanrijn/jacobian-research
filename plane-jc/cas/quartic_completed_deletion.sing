// Independent exact replay for QLD4.
//
// At the clean 3+1 cusp the completed order is
//
//   QQ[[T,r,s,a]]/(a*s^2-r^2*(4*r-9*T^2)).
//
// The script asks Singular to compute its normalization and conductor,
// compares the returned normalization with the displayed determinantal
// presentation, and independently checks that the determinantal ring is
// normal.

LIB "normal.lib";

ring R = 0,(T,r,s,a),dp;

proc assertSameIdeal(ideal first, ideal second, string message)
{
  if (
    size(reduce(first,std(second))) != 0
    || size(reduce(second,std(first))) != 0
  )
  {
    ERROR(message);
  }
}

poly ell = 4*r-9*T2;
ideal orderIdeal = a*s2-r2*ell;
list normalization = normal(orderIdeal);

// The returned integral basis is 1 and r*ell/s.
ideal moduleNumerators = normalization[2][1];
assertSameIdeal(
  moduleNumerators,
  ideal(r*ell,s),
  "normalization module is not generated by 1 and r*ell/s"
);

ideal conductor = normalConductor(orderIdeal);
assertSameIdeal(
  conductor,
  ideal(r,s),
  "the completed-order conductor is not (r,s)"
);

// Singular names the added normalization variable T(1).  With z=-T(1),
// its normalization ideal must be the minors of [[a,z,r],[z,ell,s]].
def NR = normalization[1][1];
setring NR;
poly q = var(1);
poly TT = var(2);
poly rr = var(3);
poly ss = var(4);
poly aa = var(5);
poly ellell = 4*rr-9*TT^2;
ideal expectedNormalization =
  aa*ellell-q^2,
  aa*ss+rr*q,
  -ss*q-rr*ellell;
assertSameIdeal(
  norid,
  expectedNormalization,
  "normalization does not equal the determinantal presentation"
);

// Check the determinantal presentation directly, without reusing the
// normalization ring returned above.
ring D = 0,(T,r,s,a,z),dp;
poly ell = 4*r-9*T2;
ideal determinantalIdeal =
  a*ell-z2,
  a*s-r*z,
  s*z-r*ell;
ideal determinantalConductor = normalConductor(determinantalIdeal);
assertSameIdeal(
  determinantalConductor,
  ideal(1),
  "the determinantal overring is not normal"
);

"PASS: cusp normalization adjoins z=r*ell/s";
"PASS: completed conductor is (r,s)";
"PASS: determinantal overring is normal";
