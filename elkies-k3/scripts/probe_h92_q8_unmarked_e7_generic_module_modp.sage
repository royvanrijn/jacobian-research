#!/usr/bin/env sage -python
"""Stack necessary generic-point q=8 conditions on all unmarked E7 curves.

At a generic unmarked exceptional component, the P1 ideal has x-x(P1) as
its lower-order generator.  The q6 fractional marked module is therefore
generated by t there.  This script uses the actual valuation atlas and q8
Cartier factors to impose only unique negative leading residues on a supplied
smooth modular kernel.  It is deliberately weaker than a full edge/node and
overlap membership compiler, but every row it adds is necessary.
"""

import argparse
import json
from pathlib import Path

from sage.all import GF, matrix, vector


ROOT = Path(__file__).resolve().parents[2]
KERNEL = ROOT / "artifacts/generated-results/elkies-k3-h92-q8-smooth-principal-parts-mod-43-extra7.json"
ATLAS = ROOT / "artifacts/generated-results/elkies-k3-h92-q6-actual-e7-valuation-atlas.json"
GLUING = ROOT / "artifacts/generated-results/elkies-k3-h92-q8-actual-e7-gluing.json"
DEFAULT_OUTPUT = ROOT / "artifacts/generated-results/elkies-k3-h92-q8-unmarked-e7-generic-module-mod-43-extra7.json"


def path_label(path):
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--kernel", type=Path, default=KERNEL)
parser.add_argument("--atlas", type=Path, default=ATLAS)
parser.add_argument("--gluing", type=Path, default=GLUING)
parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
args = parser.parse_args()

kernel = json.loads(args.kernel.read_text())
atlas = json.loads(args.atlas.read_text())
gluing = json.loads(args.gluing.read_text())
assert kernel["status"] == "EXPERIMENTAL_MODULAR_SMOOTH_BLOCK_RANK"
assert atlas["status"] == "PASS_EXACT_H92_E7_VALUATION_ATLAS"
assert gluing["status"] == "PASS_EXACT_Q8_ACTUAL_E7_GLUING"
finite = GF(int(kernel["prime"]))
basis = kernel["ambient_basis"]
smooth_rows = matrix(finite, [[finite(int(value)) for value in row] for row in kernel["kernel_basis_rows"]])
assert smooth_rows.nrows() == int(kernel["dimensions"]["kernel"])

edges = {entry["name"]: entry for entry in gluing["actual_edge_chart_gluing"]}
unmarked = [entry for entry in atlas["entries"] if entry["component"] != "E7_5"]
assert len(unmarked) == 6


def component_data(entry):
    t_order, x_order, y_order = (int(entry["old_coordinate_orders"][key]) for key in ("t", "x", "y"))
    xp_order, yp_order = 2*t_order, 3*t_order
    lx_order, ly_order = min(x_order, xp_order), min(y_order, yp_order)
    assert lx_order < ly_order
    edge = edges[entry["edge_chart"]]
    component = next(item for item in edge["components"] if item["name"] == entry["component"])
    return t_order, x_order, ly_order-lx_order, int(component["w_coefficient"])


all_constraints = []
records = []
rank = 0
for entry in unmarked:
    t_order, x_order, m_order, g_order = component_data(entry)
    by_order = {}
    for label in range(len(basis)):
        if not any(smooth_rows[row, label] for row in range(smooth_rows.nrows())):
            continue
        value = basis[label]
        residual = (
            g_order + (4*int(value["h_power"])-int(value["u_power"])-9)*t_order
            + int(value["x_power"])*x_order + int(value["m_power"])*m_order
        )
        by_order.setdefault(residual, []).append(label)
    for residual in sorted(by_order):
        labels = by_order[residual]
        if residual >= 0 or len(labels) != 1:
            continue
        label = labels[0]
        row = vector(finite, [smooth_rows[index, label] for index in range(smooth_rows.nrows())])
        next_rank = matrix(finite, len(all_constraints)+1, smooth_rows.nrows(), all_constraints+[row]).rank()
        if next_rank > rank:
            all_constraints.append(row)
            rank = next_rank
            records.append({
                "component": entry["component"],
                "edge_chart": entry["edge_chart"],
                "residual_order": int(residual),
                "basis_index": int(label),
                "basis_label": basis[label],
                "coefficient_on_smooth_kernel_basis": [int(value) for value in row],
            })
        if rank == smooth_rows.nrows():
            break
    if rank == smooth_rows.nrows():
        break

survivors = smooth_rows.nrows()-rank
payload = {
    "schema": "elkies-k3.h92-q8-unmarked-e7-generic-module-modp.v1",
    "status": "EXPERIMENTAL_MODULAR_UNMARKED_E7_GENERIC_MODULE_SCREEN",
    "prime": int(kernel["prime"]),
    "inputs": {"smooth_kernel": path_label(args.kernel), "atlas": path_label(args.atlas), "gluing": path_label(args.gluing)},
    "components_tested": [entry["component"] for entry in unmarked],
    "smooth_kernel_dimension": int(smooth_rows.nrows()),
    "independent_unique_leading_constraints": records,
    "survivor_dimension_after_generic_unmarked_E7_conditions": int(survivors),
    "boundary": "Only generic unmarked E7 points are tested. This does not test marked P1, edge nodes, overlap gluing, characteristic-zero lifting, a pencil, or rank.",
}
args.output.parent.mkdir(parents=True, exist_ok=True)
args.output.write_text(json.dumps(payload, indent=2, sort_keys=True)+"\n")
print("H92Q8UNMARKEDE7GENERIC|prime={}|smooth_kernel={}|constraints={}|survivor={}|status=EXPERIMENTAL_MODULAR_UNMARKED_E7_GENERIC_MODULE_SCREEN".format(kernel["prime"], smooth_rows.nrows(), rank, survivors), flush=True)
