{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elkies_k3_lattice_foundry_ns0024_mw4_family.schema.json",
  "title": "Certified finite-field NS0024 MW4 source family",
  "type": "object",
  "required": [
    "schema",
    "status",
    "prime",
    "parameters",
    "surface",
    "sections",
    "marking",
    "proof_boundary"
  ],
  "properties": {
    "schema": {
      "const": "elkies-k3.lattice-foundry-ns0024-mw4-family-modp.v1"
    },
    "status": {
      "const": "PASS_EXACT_MODULAR_NS0024_MW4_FAMILY_MARKING"
    },
    "prime": {
      "type": "integer",
      "minimum": 11
    },
    "extension": {
      "type": "object",
      "description": "Optional exact constant-field extension GF(p^d).",
      "required": ["generator", "modulus"],
      "properties": {
        "generator": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "modulus": {
          "type": "string",
          "description": "An irreducible polynomial in the named generator over GF(p)."
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "maxItems": 1,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
    },
    "surface": {
      "type": "object",
      "required": ["A_coefficients_low_to_high", "B_coefficients_low_to_high"],
      "properties": {
        "A_coefficients_low_to_high": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {"type": ["integer", "string"]}
        },
        "B_coefficients_low_to_high": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "items": {"type": ["integer", "string"]}
        }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "object",
      "required": ["P1", "P2", "P3", "P4"],
      "properties": {
        "P1": {"$ref": "#/$defs/section"},
        "P2": {"$ref": "#/$defs/section"},
        "P3": {"$ref": "#/$defs/section"},
        "P4": {"$ref": "#/$defs/section"}
      },
      "additionalProperties": false
    },
    "marking": {
      "type": "object",
      "required": [
        "minimum_basis_sha256",
        "normalized_supports",
        "section_profiles_I7_I5_I4",
        "section_intersection_gram"
      ],
      "properties": {
        "minimum_basis_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "normalized_supports": {
          "const": {"I7": "0", "I5": "1", "I4": "infinity"}
        },
        "section_profiles_I7_I5_I4": {
          "const": {
            "P1": [1, 0, 0],
            "P2": [2, 1, 3],
            "P3": [2, 1, 1],
            "P4": [1, 1, 1]
          }
        },
        "section_intersection_gram": {
          "const": [
            [-2, 1, 2, 1],
            [1, -2, 0, 1],
            [2, 0, -2, 1],
            [1, 1, 1, -2]
          ]
        }
      },
      "additionalProperties": true
    },
    "proof_boundary": {
      "type": "object",
      "required": ["proved", "not_proved"]
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": ["integer", "string"],
          "description": "Exact Sage expression in t and the optional family parameter."
        },
        "y": {
          "type": ["integer", "string"],
          "description": "Exact Sage expression in t and the optional family parameter."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
