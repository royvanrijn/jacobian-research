{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elkies-k3.exact-neighbor-input.v1",
  "title": "Exact elliptic-neighbor lattice input",
  "type": "object",
  "required": ["schema", "ns_gram", "old_fiber", "divisor", "supplied_curves"],
  "properties": {
    "schema": {"const": "elkies-k3.exact-neighbor-input.v1"},
    "ns_gram": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "items": {"type": "integer"}
      }
    },
    "old_fiber": {"$ref": "#/$defs/integerVector"},
    "divisor": {"$ref": "#/$defs/integerVector"},
    "supplied_curves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "class"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "class": {"$ref": "#/$defs/integerVector"}
        },
        "additionalProperties": false
      }
    },
    "proof_metadata": {"type": "object"},
    "expected_old_fiber_degree": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "integerVector": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer"}
    }
  }
}
