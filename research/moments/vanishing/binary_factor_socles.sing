ring rMIN_ZERO=(0,b,c,e,f),(a,d),dp;
option(redSB);
ideal I=a^2*b*e*f^2 + a^2*c*e^2*f + a*b^2*d*f^2 + 4*a*b*c*d*e*f + a*c^2*d*e^2 + b^2*c*d^2*f + b*c^2*d^2*e,-3*a^4*b^2*e^2*f^4 - 5*a^4*b*c*e^3*f^3 - 3*a^4*c^2*e^4*f^2 - 5*a^3*b^3*d*e*f^4 - 18*a^3*b^2*c*d*e^2*f^3 - 18*a^3*b*c^2*d*e^3*f^2 - 5*a^3*c^3*d*e^4*f - 3*a^2*b^4*d^2*f^4 - 18*a^2*b^3*c*d^2*e*f^3 - 33*a^2*b^2*c^2*d^2*e^2*f^2 - 18*a^2*b*c^3*d^2*e^3*f - 3*a^2*c^4*d^2*e^4 - 5*a*b^4*c*d^3*f^3 - 18*a*b^3*c^2*d^3*e*f^2 - 18*a*b^2*c^3*d^3*e^2*f - 5*a*b*c^4*d^3*e^3 - 3*b^4*c^2*d^4*f^2 - 5*b^3*c^3*d^4*e*f - 3*b^2*c^4*d^4*e^2,a^6*b^3*e^3*f^6 + 3*a^6*b^2*c*e^4*f^5 + 3*a^6*b*c^2*e^5*f^4 + a^6*c^3*e^6*f^3 + 3*a^5*b^4*d*e^2*f^6 + 15*a^5*b^3*c*d*e^3*f^5 + 24*a^5*b^2*c^2*d*e^4*f^4 + 15*a^5*b*c^3*d*e^5*f^3 + 3*a^5*c^4*d*e^6*f^2 + 3*a^4*b^5*d^2*e*f^6 + 24*a^4*b^4*c*d^2*e^2*f^5 + 60*a^4*b^3*c^2*d^2*e^3*f^4 + 60*a^4*b^2*c^3*d^2*e^4*f^3 + 24*a^4*b*c^4*d^2*e^5*f^2 + 3*a^4*c^5*d^2*e^6*f + a^3*b^6*d^3*f^6 + 15*a^3*b^5*c*d^3*e*f^5 + 60*a^3*b^4*c^2*d^3*e^2*f^4 + 93*a^3*b^3*c^3*d^3*e^3*f^3 + 60*a^3*b^2*c^4*d^3*e^4*f^2 + 15*a^3*b*c^5*d^3*e^5*f + a^3*c^6*d^3*e^6 + 3*a^2*b^6*c*d^4*f^5 + 24*a^2*b^5*c^2*d^4*e*f^4 + 60*a^2*b^4*c^3*d^4*e^2*f^3 + 60*a^2*b^3*c^4*d^4*e^3*f^2 + 24*a^2*b^2*c^5*d^4*e^4*f + 3*a^2*b*c^6*d^4*e^5 + 3*a*b^6*c^2*d^5*f^4 + 15*a*b^5*c^3*d^5*e*f^3 + 24*a*b^4*c^4*d^5*e^2*f^2 + 15*a*b^3*c^5*d^5*e^3*f + 3*a*b^2*c^6*d^5*e^4 + b^6*c^3*d^6*f^3 + 3*b^5*c^4*d^6*e*f^2 + 3*b^4*c^5*d^6*e^2*f + b^3*c^6*d^6*e^3;
print("MIN_ZERO_START");ideal G=std(I);ideal m=a,d;ideal K=std(quotient(G,m));
print("MIN_ZERO_SOCLE_GENERATORS");print(size(reduce(K,G)));
print("MIN_ZERO_FORWARD");print(size(reduce(K*m,G)));print("MIN_ZERO_REVERSE");print(size(reduce(G,K)));
