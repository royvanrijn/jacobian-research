LIB "elim.lib";
ring r=0,(d2,d3,h1),dp;
option(redSB);
ideal I=-112*d2^2 - 320*d2*h1^2 + 896*d2*h1 - 360*d2 - 640*d3*h1 + 1120*d3 - 112*h1^2 + 480*h1 - 495,96*d2^3 + 1008*d2^2*h1^2 - 1728*d2^2*h1 + 144*d2^2 + 2016*d2*d3*h1 - 2016*d2*d3 + 792*d2*h1^2 - 2736*d2*h1 + 2466*d2 + 1008*d3^2 - 448*d3*h1^3 + 2016*d3*h1^2 - 2520*d3*h1 + 672*d3 + 96*h1^3 - 549*h1^2 + 1080*h1 - 723,2816*d2^4 + 4096*d2^3*h1^2 - 90112*d2^3*h1 + 81152*d2^3 + 8192*d2^2*d3*h1 - 101376*d2^2*d3 + 45056*d2^2*h1^4 - 262144*d2^2*h1^3 + 451584*d2^2*h1^2 - 198656*d2^2*h1 - 20960*d2^2 - 22528*d2*d3^2 + 262144*d2*d3*h1^3 - 1155072*d2*d3*h1^2 + 1511424*d2*d3*h1 - 478720*d2*d3 + 26624*d2*h1^4 - 212992*d2*h1^3 + 590592*d2*h1^2 - 657920*d2*h1 + 235728*d2 + 270336*d3^2*h1^2 - 901120*d3^2*h1 + 760320*d3^2 - 8192*d3*h1^4 + 131072*d3*h1^3 - 583680*d3*h1^2 + 1026560*d3*h1 - 634304*d3 + 2816*h1^4 - 28672*h1^3 + 102592*h1^2 - 155520*h1 + 85227;
poly discPoly=d2^2-4*d3-4*d2^3-27*d3^2+18*d2*d3;
poly goodPoly=d3*discPoly*(4*d2+4*h1-5);
ideal G=std(I);print("EIGHTH_PREFIX_DIMENSION");print(dim(G));
print("EIGHTH_PREFIX_LENGTH");print(vdim(G));
ideal Good=sat(G,ideal(goodPoly));
print("GOOD_WITNESS_LENGTH");print(vdim(Good));print("GOOD_WITNESS_BASIS");print(Good);
ideal Bad=std(Good+ideal(goodPoly));print("BAD_LOCUS_IDEAL");print(Bad);
print("END");quit;
