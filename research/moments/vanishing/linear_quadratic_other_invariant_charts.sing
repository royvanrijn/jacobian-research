LIB "elim.lib";
ring rLQ_NONISO_D1ZERO_H1=0,(d2,d3),dp;
option(redSB);
ideal All=-7*d2^2 - 20*d2 - 40*d3,6*d2^3 + 63*d2^2 + 126*d2*d3 + 63*d3^2 - 28*d3,11*d2^4 + 16*d2^3 + 32*d2^2*d3 + 176*d2^2 - 88*d2*d3^2 + 1024*d2*d3 + 1056*d3^2,-130*d2^5 - 2585*d2^4 - 5170*d2^3*d3 - 5720*d2^3 - 2145*d2^2*d3^2 - 25080*d2^2*d3 - 34320*d2*d3^2 + 2288*d2*d3 - 14300*d3^3 + 5720*d3^2;
for(int kk=2;kk<=4;kk++){ideal I=0;for(int jj=1;jj<=kk;jj++){I=I,All[jj];}
print("LQ_NONISO_D1ZERO_H1_GATE");print(2*(kk+1));ideal G=std(I);print("LQ_NONISO_D1ZERO_H1_BASIS_SIZE");print(size(G));print("LQ_NONISO_D1ZERO_H1_BASIS");print(G);
for(int pp=1;pp<=4;pp++){poly remainderPoly=reduce(d3^pp,G);print("LQ_NONISO_D1ZERO_H1_POWER");print(pp);print(size(remainderPoly));if(remainderPoly==0){break;}}
ideal Sat=sat(G,ideal(d3));print("LQ_NONISO_D1ZERO_H1_SATURATED");print(Sat);if(reduce(1,Sat)==0){break;}
}
ring rLQ_NONISO_D1H1ZERO_D2=0,(d3),dp;
option(redSB);
ideal All=-1,21*d3^2 + 2,1 - 8*d3^2,-33*d3^2 - 2;
for(int kk=2;kk<=4;kk++){ideal I=0;for(int jj=1;jj<=kk;jj++){I=I,All[jj];}
print("LQ_NONISO_D1H1ZERO_D2_GATE");print(2*(kk+1));ideal G=std(I);print("LQ_NONISO_D1H1ZERO_D2_BASIS_SIZE");print(size(G));print("LQ_NONISO_D1H1ZERO_D2_BASIS");print(G);
for(int pp=1;pp<=4;pp++){poly remainderPoly=reduce(d3^pp,G);print("LQ_NONISO_D1H1ZERO_D2_POWER");print(pp);print(size(remainderPoly));if(remainderPoly==0){break;}}
ideal Sat=sat(G,ideal(d3));print("LQ_NONISO_D1H1ZERO_D2_SATURATED");print(Sat);if(reduce(1,Sat)==0){break;}
}
ring rLQ_ISO_H1=0,(d1,d2,d3),dp;
option(redSB);
ideal I=-7*d1^2 - 20*d2,3*d1^3 - 14*d3,11*d1^4 + 104*d1^2*d2 - 32*d1*d3 + 176*d2^2;
ideal G=std(I);print("LQ_ISO_H1_BASIS");print(G);print("LQ_ISO_H1_D3_POWER");print(reduce(d3^4,G));
print("END");quit;
