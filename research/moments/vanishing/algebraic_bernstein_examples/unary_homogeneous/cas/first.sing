LIB "dmodapp.lib";

proc emit(poly v,string label)
{
  print("BEGIN|"+label);
  while(v!=0)
  {
    print("TERM|"+label+"|"+string(leadexp(v))+"|"+string(leadcoef(v)));
    v=v-lead(v);
  }
  print("END|"+label);
}
ring R=0,(z1,h,D1,Dh),dp; def W=Weyl();setring W;
ideal InputIdeal=z1-h*((2/1)*((-D1))^1),Dh-((1/1)*((-D1))^2);
def A=SDLoc(InputIdeal,(1/1)*(z1)^3);setring A;
ideal F=LD,(1/1)*(z1)^3;ideal C=std(F);ideal Bs=nselect(C,1..4);poly B=Bs[1];
matrix L=lift(F,ideal(B));poly Q=L[ncols(F),1];
print("CHECK|ordinary|"+string(reduce(B-Q*((1/1)*(z1)^3),std(LD))));
emit(B,"ordinary_B");emit(Q,"ordinary_Q");
ring V0=(0,u),(z1,h,D1,Dh),dp;def V=Weyl();setring V;
map Phi=A,z1,h,D1,Dh,u;ideal GenericIdeal=Phi(LD);
def G=SDLoc(GenericIdeal,h);setring G;ideal F=LD,h;ideal C=std(F);
ideal Bs=nselect(C,1..4);poly B=Bs[1];matrix L=lift(F,ideal(B));poly Q=L[ncols(F),1];
print("CHECK|eta_generic|"+string(reduce(B-Q*h,std(LD))));
emit(B,"generic_eta_B");emit(Q,"generic_eta_Q");print("STAGE_COMPLETE|first");quit;
