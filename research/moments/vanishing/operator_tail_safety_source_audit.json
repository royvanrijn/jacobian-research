  "high_order_tail_theorem": {
    "scope": "Every commutative Q-algebra,polynomial phase degree<=D,finite or formal constant-coefficient base/tail symbols",
    "input": "Base pair has all-marker linear cutoffC>=1,including purity;tail derivative order s>D(CD+1)",
    "bound": "C_tail=ceil((sC+CD+1)/(s-D(CD+1)))",
    "proof": "For l tail factors,a nonzero term requiresm<=Cdelta+(CD+1)l andsl<=delta+Dm;eliminate l",
    "pure": "All perturbed positive pure outputs equal the base outputs under the input cutoff assumption",
    "convenient": "s>=2D(CD+1) gives sufficient cutoff2C+1",
    "ordinary": "After adjoining arbitrary tail coefficients,I_Ctail(total) subset I_C(base) extension;no equality of mixed ideals claimed",
    "scope_boundary": "No phase deformation,positive-weight assumption,variable-coefficient extension or arbitrary unsafe-core repair"
  },
  "finite_jet_certificate": {
    "equivalence": "A formal pair has some linear cutoff iff a finite truncation throughr has cutoffC andr+1>D(CD+1)",
    "necessity": "If original cutoff isC0,truncationr=D((2C0+1)D+1) has cutoff<=2C0+1 and meets the tail test",
    "functor": "Linear-cutoff formal pairs over arbitrary Q-algebras form a union of closed finite-jet cylinders defined by full ordinary finite-order cutoff ideals",
    "boundary": "No single closed scheme,exact prescribed-slope ideal equality or least formal mixed cutoff is deduced"
  },
  "formal_positive_semidecision": {
    "domain": "A polynomial phase over a fixed effective number field and a coefficient procedure for the formal symbol",
