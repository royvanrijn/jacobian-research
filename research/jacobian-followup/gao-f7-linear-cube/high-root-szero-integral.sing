ring rr=0,(a,b),dp;
short=0;
option(redSB);
ideal I=6*a^4 + 12*a^3 + 7*a^2 - 2*a*b + a - b,-16*a^5 - 40*a^4 - 32*a^3 + 8*a^2*b - 11*a^2 + 8*a*b - 5*a,16*a^6 + 48*a^5 + 52*a^4 - 16*a^3*b + 38*a^3 - 24*a^2*b + 29*a^2 - 8*a*b + 11*a + 4*b^2 - 2*b,-28*a^4 - 64*a^3 - 44*a^2 + 4*a*b - 8*a + 6*b - 1;
matrix L=lift(I,ideal(1));
print("BEGIN_MULTIPLIERS");
int j;
for (j=1;j<=nrows(L);j++) { print(string(L[j,1])); }
print("END_MULTIPLIERS");
quit;
