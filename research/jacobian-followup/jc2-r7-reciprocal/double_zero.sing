ring R=0,(E,D,B,a),dp;
option(redSB);
poly f1=60*B*a^3 - 36*B - 162*D*a + 243*E - 35*a^4 + 60*a;
poly f2=-60*B*a^4 + 90*B*a + 162*D*a^2 - 243*E*a + 35*a^5 - 105*a^2;
poly f3=240*B*a^5 - 450*B*a^2 - 648*D*a^3 + 81*D + 972*E*a^2 - 140*a^6 + 490*a^3 - 18;
poly f4=-480*B*a^6 + 660*B*a^3 + 54*B + 1296*D*a^4 + 162*D*a - 1944*E*a^3 - 243*E + 280*a^7 - 805*a^4 - 90*a;
poly f5=960*B*a^7 + 660*B*a^4 - 1404*B*a - 2592*D*a^5 - 3726*D*a^2 + 3888*E*a^4 + 4131*E*a - 560*a^8 + 245*a^5 + 2070*a^2;
ideal I=f1,f2,f3,f4,f5;
ideal G=slimgb(I);
short=0;
print("SIZE "+string(size(G)));
print("DIM "+string(dim(G)));
G;
ideal T=a,B,D-2/9,E;
matrix L=lift(I,T);
int i,j;for(j=1;j<=ncols(L);j++){for(i=1;i<=nrows(L);i++){print("CERT "+string(i)+" "+string(j)+" "+string(L[i,j]));}}
quit;
