int count=0;int k;
for(k=1;k<=size(ip25);k++){if(deg(ip25[k])>0){count++;require(deg(ip25[k])==deg(Projection[26]),"projection squarefree irreducibility 25");}}
require(count==1,"projection irreducibility 25");
