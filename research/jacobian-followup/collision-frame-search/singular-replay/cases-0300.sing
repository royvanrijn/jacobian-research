require(deg(B[i])>0 && leadcoef(B[i])==1,"monic positive root polynomial");
for(j=1;j<i;j++){
require(deg(gcd(B[i],B[j]))==0,"coprime root basis");
}
}
for(i=1;i<=size(P);i++){q=P[i];if(q!=0){
for(j=1;j<=size(B);j++){
