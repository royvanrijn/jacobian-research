/* [wxMaxima: input   start ] */
/* To be included in introduction */;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Alpöge's counterexample to JC3 */
F: [(1+x1*x2)^3*x3 + x2^2*(1+x1*x2)*(4+3*x1*x2),x2+3*x1*(1+x1*x2)^2*x3+3*x1*x2^2*(4+3*x1*x2), 2*x1 - 3*x1^2*x2 -x1^3*x3];
/* Alpöge's counterexample multiplies volume by 2 and flips orientation. */
expand(determinant(jacobian(F,[x1,x2,x3])));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Tweak of Alpöge's counterexample whose linear part is the identity map */
/* therefore volume- and orientation-preserving */
v: (1+2*x1*x2);
G: [x1 - 3*x1^2*x2 - x1^3*x3, 3*v^2*x1*x3 + (9*v^2-6*v-2)*x2,  v^3*x3 + (6*v^2+2*v)*x2^2];
ratsimp(G - subst([x2=2*x2,x3=2*x3],1/2*[F[3],F[2],F[1]]));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Collision points on first axis, checked by substitution */
SF1: solve([F[1]=t,F[2]=0,F[3]=0],[x1,x2,x3]); makelist(ratsimp(subst(SF1[i],F)),i,1,length(SF1)); 
/* Alpöge's collision point */
SFa: subst(t=-1/4,SF1); makelist(subst(SFa[i],F),i,1,length(SFa)); 
/* Alternative collision point, with the shared last coordinate of two preimages integral, namely 26 */
SFb: subst(t=-1,SF1); makelist(subst(SFb[i],F),i,1,length(SFb));

/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Corresponding collision points of G (third axis), checked by substitution */
SG1: solve([G[1]=0,G[2]=0,G[3]=1/2*t],[x1,x2,x3]); makelist(ratsimp(subst(SG1[i],G)),i,1,length(SG1)); 
/* Alpöge's collision point */
SGa: subst(t=-1/4,SG1); makelist(subst(SGa[i],G),i,1,length(SGa)); 
/* Alternative collision point, with the shared last coordinate of two preimages integral, namely 13 */
SGb: subst(t=-1,SG1); makelist(subst(SGb[i],G),i,1,length(SGb));

/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Collision points on second axis, checked by substitution */
SF2: solve([F[1]=0,F[2]=t,F[3]=0],[x1,x2,x3]); makelist(ratsimp(subst(SF2[i],F)),i,1,length(SF2));
/* Collision point with three integral preimages */
SFc: subst(t=-2,SF2); makelist(subst(SFc[i],F),i,1,length(SFc));
/*Another collision point with three integral preimages */
SFd: subst(t=2,SF2); makelist(subst(SFd[i],F),i,1,length(SFd));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Corresponding collision points of G (second axis), checked by substitution */
SG2: solve([G[1]=0,G[2]=t/2,G[3]=0],[x1,x2,x3]); makelist(ratsimp(subst(SG2[i],G)),i,1,length(SG2));
/* Collision point with two integral preimages */
SGc: subst(t=-2,SG2); makelist(subst(SGc[i],G),i,1,length(SGc));
/*Another collision point with two integral preimages */
SGd: subst(t=2,SG2); makelist(subst(SGd[i],G),i,1,length(SGd));
/* [wxMaxima: input   end   ] */



