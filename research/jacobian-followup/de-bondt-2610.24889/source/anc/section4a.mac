/* [wxMaxima: input   start ] */
id_x(n) := makelist(concat(x,i), i, 1, n);
subst_mulpow_t(F,n,d) := block(s, s: id_x(n), expand(subst(makelist(s[i]=t^d*s[i],i,1,n),F)));
deg_xt(f,n) := hipow(subst_mulpow_t(f,n,1),t);
hmg_part_xt(f,n,d) :=  ratsimp(t^d*subst_mulpow_t(coeff(subst_mulpow_t(f,n,1),t,d),n,-1));
subst_x(P,F) := makelist(subst(makelist(concat(x,i)=P[j][i],i,1,length(P[j])),F),j,1,length(P));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
v: (1+2*x1*x2);
F: [x1 - 3*x1^2*x2 - x1^3*x3, 3*v^2*x1*x3 + (9*v^2-6*v-2)*x2,  v^3*x3 + (6*v^2+2*v)*x2^2];
expand(subst([x1=x,x2=y,x3=z],F));
P: [[0,1,-8], [-1,1,4]];
subst_x(P,F);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
divide_by_monomial(poly, mon) := block([q, vars, r],
    q: expand(poly),
    vars: listofvars(mon),
    
    for i: 1 thru length(vars) do
        q: quotient(q, vars[i]^hipow(mon, vars[i])),
    
    r: expand(poly - mon*q),
    [q, r]
);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
highest_term(f,n) := block([ht, d, hc],
    d: deg_xt(f,n),
    ht: hmg_part_xt(f, n, d),
    if not atom(ht) and op(ht) = "+" then
        ht: args(ht)[1],
    
    cf: subst(makelist(concat(x,i)=1,i,n),ht),
    if cf = 0 then
        [1,0,0]
    else
        [ratsimp(ht/cf),d,cf]
);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Hoofdfunctie voor het splitsen van de monoom */
split_monomial(m, n, core_monomials) := block([d,d2,ret,div_res],
    
    /* 1. Begin met het onthouden van [0, 0] */
    d: deg_xt(m,n),
    d2: ceiling(d/2),
    ret: [0,0],
    
    /* 2. Loop door de core_monomials om een deler i van de juiste graad te vinden */
    for i:1 thru length(core_monomials) do (
        
        if deg_xt(core_monomials[i],n) = d2 then (
            div_res: divide_by_monomial(m, core_monomials[i]),
            
            /* Check of grid_mon een exacte deler is van m */
            if div_res[2] = 0 then (
                /* We hebben een geldige deler gevonden. Update het onthouden paar naar [i, 0] */
                if ret[1] = 0 then ret: [i, 0],
                
                /* 3. Kijk of de cofactor (quot) in core_monomials zit */
                for j:1 thru length(core_monomials) do (
                    if ret[2] = 0 and ratsimp(core_monomials[j] - div_res[1]) = 0 then ret: [i,j]
                )
            )
                
        )
    ),
    
    /* 4. Retourneer de onthouden waarde */
    ret
);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
bcw_degree_reduction(F_in, P) := block([G, m, core_monomials, c, res, split, Gch],
    
    core_monomials : [
        x1^2*x2*x3, /* x4  (graad 4) */
        x1^2*x3,      /* x5  (graad 3) */
        x1*x2^2,      /* x6  (graad 3) */
        x1^2,           /* x7  (graad 2) */
        x1*x2,          /* x8  (graad 2) */
        x1*x3,          /* x9  (graad 2) */
        x2*x6           /* x10 (graad 2) */
    ],
    
    G : copy(F_in),
    m : length(G), /* Begint op 3 */
    
    /* Bouw de initiële uitbreiding van F naar G (variabelen x4 t/m x10) */
    for k:1 thru length(core_monomials) do (
        m : m + 1,
        G : append(G, [concat(x, m) + core_monomials[k]])
    ),
    
    print("Initial 10-dimensional G created."),
    
    /* Loop uitsluitend over de componenten 1 tot en met 4 */
    for c:1 thru 4 do (
        G[c] : expand(G[c]),
        res : highest_term(G[c], m), /* res is [ht, d, hc] */
        
        while res[2] >= c*(5-c)/2 + 2 do (
            split : split_monomial(res[1], m, core_monomials),
            
            if split[1] = 0 or split[2] = 0 then (
                error("CRITICAL ERROR: No divisors found in core_monomials for:", res[1])
            ),
            
            i : split[1] + 3, 
            
            /* Casus B: Alleen deler i gevonden, cofactor is nieuw */
            if split[2] = 0 then (
                m : m + 1,
                G : append(G, [concat(x, m) + ratsimp(res[1] / core_monomials[split[1]])]),
                j : m
            ) 
            /* Casus A: Volledige match gevonden binnen de bestaande grid */
            else (
                j : split[2] + 3
            ), 
            
            /* Voer de exacte algebraïsche reductiestap uit */
            Gch: expand(G[c] - hmg_part_xt(G[c],m,3) - hmg_part_xt(G[c],m,2) - concat(x,c)),
            G[c]: expand(G[c] - res[3] * G[split[1] + 3] * G[split[2] + 3]),
            print("Component", c, "excess", Gch, ": reducing term", res[1], "using", G[split[1] + 3], "and", G[split[2] + 3]),
            
            /* Bereken de hoogste term opnieuw voor de volgende iteratie van deze component */
            res : highest_term(G[c], m)
        ),
        if res[2] = 4 then (
            Gch: hmg_part_xt(G[c],m,4),
            split: divide_by_monomial(Gch,x1*x2),
            m: m + 1,
            G: append(G,[concat(x,m)+split[1]]),
            G[c]: expand(G[c] - G[8]*G[m]),
            print("Component", c, "excess", Gch, ": reducing x1*x2 terms using", G[8], "and", G[m]),
            Gch: split[2],
            split: divide_by_monomial(Gch,x1*x3),
            m: m + 1,
            G: append(G,[concat(x,m)+split[1]]),
            G[c]: expand(G[c] - G[9]*G[m]),
            print("Component", c, "excess", Gch, ": reducing x1*x3 terms using", G[9], "and", G[m])
        )        
    ),
    
    print("BCW degree reduction finished successfully! Final dimension:", length(G)),
    
    /* Compute points */
    Q: [],
    for j: 1 thru length(P) do (
        q: copy(P[j]),
        for i: length(F_in)+1 thru m do
            q: append(q, subst_x([q], [subst([t=1, concat(x, i)=0], -G[i])])[1]),
        q[4]: subst([x8=q[8],x[9]=q[9]], q[4]),
        if hmg then q: endcons(1, q),
        Q: endcons(q,Q)
    ),    
    
    return([G,Q])
);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
res: bcw_degree_reduction(F,P)$ Fcub: res[1]; Pcub: res[2]; subst_x(Pcub,Fcub);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
sum(deg_xt(Fcub[i],30)-1,i,1,length(Fcub)) + 1;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
makelist([i,deg_xt(Fcub[i],30)],i,1,length(Fcub));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
FF: append(endcons(x4 + x1^2*x2*x3,F), makelist(expand(Fcub[i]), i, 5, 14));
E: [y1 + y7*y9, y2 - 12*y5*y6 - 36*y6*y8 - y8*y11 - y9*y12, 
    y3 - 8*y4*y6 -24*y6^2 - 12*y6*y9 + 8*y5*y10 - y8*y13 - y9*y14,
    y4 -y8*y9, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14];
FFcub: expand(subst(makelist(concat(y,i)=FF[i],i,1,14),E));
expand(FFcub - Fcub);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* reduce the degree of a polynomial f with a new component */
/* the leading homogeneous part of f must be divisible by t ^ (deg(f) - d) */
reduce_degree(f, n, d) := block([degf, g, h],    
    /* degree of f in x1, x2, ..., xn, t */
    degf: deg_xt(f,n),
    
    /* if f has already degree ≤ d, then there is nothing to do */
    if degf <= d then return([f, 0]),

    /* for new component, take leading homogeneous part, */
    /* divide by t^(d-degf) and add new variable */
    h: ratsimp(hmg_part_xt(f, n, degf) / t^(degf - d)) + concat(x, n+1),
    
    /* reduce degree of f with h */
    g: expand(f - h *  t^(degf - d)),

    /* return reduced polynomial and new component */
    [g, h]
  );
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Make all components of F of degree at most d */
reduce_map(F, d) := block([n, G, m, res],
    n : length(F),
    m : n,
    
    /* substitute x = t^(d-2) * x in F / t^(d-2) */
    G: subst_mulpow_t(F / t^(d-2), n, d-2),

    /* iterate over the current components of G */
    for i : 1 thru n do (
        /* repeat reducing the degree until G[i] has the right degree */
        res: reduce_degree(G[i], m, d),
        while res[2] # 0 do (
            G[i] : res[1],
            G : endcons(res[2], G),
            m: m + 1,
            res: reduce_degree(G[i], m, d)
        )
    ),

    /* return reduced map */
    G
);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/* Make an unipotent map from F of degree deg(F) with n + sum_i max(deg(F_i) - 2, 0) components */
/* Make a unipotent homogeneous map from F of degree deg(F) with n + sum_i max(deg(F_i) - 2, 0) + 1 components */
make_unipotent(F, P, hmg) := block([n, d, G, m, Q, q, i, j],    
    n: length(F),
    /* Test if linear part is the identity map */
    if not ratsimp(subst(t=0, subst_mulpow_t(F / t, n, 1))) = id_x(n) then
        error("Linear part is not the identity map!"),
    
    /* perform unipotent reduction */
    d: apply(max, makelist(deg_xt(F[i], n), i, 1, n)),
    G: reduce_map(F, d),
    m: length(G),    
    
    /* Compute points */
    Q: [],
    for j: 1 thru length(P) do (
        q: P[j]/t^(d-2),
        for i: n+1 thru m do
            q: append(q, subst_x([q], [concat(x,i)-G[i]])[1]),
        q: subst(t=t^(-1/(d-1)),q/t),
        if hmg then q: endcons(1, q),
        Q: endcons(q,Q)
    ),
    
    /* return unipotent map */
    if hmg then
        [subst(t=concat(x,length(G) + 1), endcons(t,G)), Q]
    else
        [subst(t=1, G), Q]
  
);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
res: make_unipotent(Fcub,Pcub,false)$ G: res[1]; Q: res[2]; 
subst_x(Q, id_x(20) + t^(-1)*(G - id_x(20)));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
res: make_unipotent(Fcub,Pcub,true)$ G_h: res[1]; Q_h: res[2]; 
subst_x(Q_h, id_x(21) + t^(-1)*(G_h - id_x(21)));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
G_druz: expand(G_h)$
G_druz[21]: G_druz[21] + x21^3$
G_druz_y: copy(G_druz)$

y_list: [x5 + 3*x8]$
y_list: endcons(-7*x2 + 2*x4 + 6*x6 + 3*x9, y_list)$
y_list: endcons(x13 + 24*x10, y_list)$
y_list: endcons(x9 - 3*x2, y_list)$
y_list: endcons(6*x2 - 12*x6 - x14, y_list)$

length(G_druz_y[2]);
G_druz_y[2]: -12*y1*x6*x21 + expand(G_druz_y[2]-(-12)*y_list[1]*x6*x21);
length(G_druz_y[2]);
length(G_druz_y[3]);
G_druz_y[3]: -4*y2*x6*x21 + expand(G_druz_y[3]-(-4)*y_list[2]*x6*x21);
length(G_druz_y[3]);
G_druz_y[3]: -y3*x8*x21 + expand(G_druz_y[3]-(-1)*y_list[3]*x8*x21);
length(G_druz_y[3]);
G_druz_y[3]: 8*y1*x10*x21 + expand(G_druz_y[3]-8*y_list[1]*x10*x21);
length(G_druz_y[3]);
length(G_druz_y[11]);
G_druz_y[11]: -12*y1*x2*x21 + expand(G_druz_y[11]-(-12)*y_list[1]*x2*x21);
length(G_druz_y[11]);
length(G_druz_y[13]);
G_druz_y[13]: -4*y2*x2*x21 + expand(G_druz_y[13]-(-4)*y_list[2]*x2*x21);
length(G_druz_y[13]);
length(G_druz_y[15]);
G_druz_y[15]:  y4*x1^2 + expand(G_druz_y[15]-y_list[4]*x1^2);
length(G_druz_y[15]);
length(G_druz_y[16]);
G_druz_y[16]: 12*y1*x2*x8 + expand(G_druz_y[16]-12*y_list[1]*x2*x8);
length(G_druz_y[16]);
