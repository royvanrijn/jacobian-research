ring R=0,(E,D,B,u),dp;
option(redSB);
poly f0=-60*B*u^3 - 36*B + 162*D*u + 243*E - 35*u^4 - 15*u;
poly f1=60*B*u^4 + 36*B*u - 162*D*u^2 - 243*E*u + 35*u^5 + 15*u^2;
poly f2=-60*B*u^5 - 126*B*u^2 + 162*D*u^3 + 81*D + 243*E*u^2 - 35*u^6 - 85*u^3 - 18;
poly f3=60*B*u^6 + 366*B*u^3 + 54*B - 162*D*u^4 - 405*D*u - 243*E*u^3 - 243*E + 35*u^7 + 260*u^4 + 90*u;
poly f4=-60*B*u^7 - 996*B*u^4 - 378*B*u + 162*D*u^5 + 1620*D*u^2 + 243*E*u^4 + 1701*E*u - 35*u^8 - 680*u^5 - 360*u^2;
poly f5=-180*B*u^2 + 324*D - 112*u^3 - 93;
poly f6=-60*B*u^3 - 189*B + 324*D*u + 972*E - 28*u^4 - 9*u;
ideal I=f0,f1,f2,f3,f4,f5,f6;
matrix M=lift(I,ideal(1));
short=0;
int i;for(i=1;i<=7;i++){print("CERT "+string(i)+" "+string(M[i,1]));}
quit;
