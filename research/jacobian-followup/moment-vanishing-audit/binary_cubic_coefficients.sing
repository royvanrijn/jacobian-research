ring r=0,(x,y,z,w),dp;
option(redSB);
ideal I=w*x + y*z,w*y^3 + x*z^3 - 3*y^2*z^2,y^3*z^3;
LIB "primdec.lib";
ideal G=std(I);print("STANDARD_BASIS");print(G);print("HILBERT_FIRST");print(hilb(G,1));
print("PRIMARY_START");list D=primdecGTZ(I);
print("PRIMARY_COUNT");print(size(D));
ideal Inter=1;
for(int j=1;j<=size(D);j++){print("COMPONENT");print(j);print("PRIMARY_IDEAL");print(std(D[j][1]));print("ASSOCIATED_PRIME");print(std(D[j][2]));Inter=intersect(Inter,D[j][1]);}
ideal GI=std(Inter);print("INTERSECTION_FORWARD");print(size(reduce(G,GI)));print("INTERSECTION_REVERSE");print(size(reduce(GI,G)));
print("END");quit;
