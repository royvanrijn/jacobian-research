ring r=0,(x,y,z,w),dp;
option(redSB);
ideal I=w*x + y*z,w*y^3 + x*z^3 - 3*y^2*z^2,y^3*z^3;
LIB "elim.lib";
ideal G=std(I);
ideal Q1=w,
z;
ideal Q2=y,
x;
ideal Q3=yz+xw,
w3,
z4-y2w2-3xzw2,
xz3+y3w-3x2w2,
z3w2,
y4w-x2z2w-3x2yw2,
y9;
print("AXIS_X_RADICAL_FORWARD");print(size(reduce(Q3,std(ideal(y,z,w)))));
print("AXIS_X_RADICAL_REVERSE");print(size(reduce(ideal(y12,z12,w12),std(Q3))));
print("AXIS_X_REGULAR");print(size(reduce(quotient(Q3,ideal(x)),std(Q3))));
ideal Q4=yz+xw,
x3,
xz3+y3w-3x2w2,
y4-x2z2-3x2yw,
x2y3,
z9;
print("AXIS_W_RADICAL_FORWARD");print(size(reduce(Q4,std(ideal(x,y,z)))));
print("AXIS_W_RADICAL_REVERSE");print(size(reduce(ideal(x12,y12,z12),std(Q4))));
print("AXIS_W_REGULAR");print(size(reduce(quotient(Q4,ideal(w)),std(Q4))));
ideal Q5=yz+xw,
w4,
xz3+y3w-3x2w2,
x4,
y4w-x2z2w-3x2yw2,
x3w3,
x3y3w,
z9,
y9;
print("ORIGIN_RADICAL_REVERSE");print(size(reduce(ideal(x12,y12,z12,w12),std(Q5))));
for(int omit=1;omit<=5;omit++){
 ideal Rest=1;
 if(omit!=1){Rest=intersect(Rest,Q1);}if(omit!=2){Rest=intersect(Rest,Q2);}if(omit!=3){Rest=intersect(Rest,Q3);}if(omit!=4){Rest=intersect(Rest,Q4);}if(omit!=5){Rest=intersect(Rest,Q5);}
 print("IRREDUNDANT_COUNT");print(omit);print(size(reduce(std(Rest),G)));
}
ideal OriginSat=std(intersect(intersect(sat(G,ideal(x)),sat(G,ideal(y))),intersect(sat(G,ideal(z)),sat(G,ideal(w)))));
print("FULL_HILBERT");print(hilb(G,1));print("ORIGIN_SAT_HILBERT");print(hilb(OriginSat,1));
ideal J=x*z,x*w,y*z,y*w;ideal Pow=J;
for(int nn=1;nn<=12;nn++){
 print("RADICAL_POWER");print(nn);print(size(Pow));print(size(reduce(Pow,G)));
 if(size(reduce(Pow,G))==0){break;}
 Pow=std(Pow*J);
}
print("END");quit;
