LIB "bfun.lib";

proc emit(poly v,string label)
{
  print("BEGIN|"+label);
  while(v!=0)
  {
    print("TERM|"+label+"|"+string(leadexp(v))+"|"+string(leadcoef(v)));
    v=v-lead(v);
  }
  print("END|"+label);
}
ring R=0,(z1,z2,h,tl,te,D1,D2,Dh,Dl,De),dp;def W=Weyl();setring W;
ideal J=((1/1)*(h)^1*(D2)^1+(1/1)*(z1)^1+(1/1)*(z1)^1*(h)^1*(Dl)^1),((1/1)*(h)^1*(D1)^1+(1/1)*(z2)^1+(1/1)*(z2)^1*(h)^1*(Dl)^1),((1/1)*(De)^1+(-1/1)*(Dl)^1+(1/1)*(Dh)^1+(-1/1)*(D1)^1*(D2)^1+(-1/1)*(z2)^1*(D2)^1*(Dl)^1+(-1/1)*(z1)^1*(D1)^1*(Dl)^1+(-1/1)*(z1)^1*(z2)^1*(Dl)^2),((1/1)*(tl)^1+(-1/1)*(z1)^1*(z2)^1),((1/1)*(te)^1+(-1/1)*(h)^1);ideal G=std(J);
poly ES=(-1/1)+(-1/1)*(tl)^1*(Dl)^1;poly OrdinaryDifference=(-2/1)+(-3/1)*(tl)^2*(Dl)^2+(-1/1)*(tl)^3*(Dl)^3+(-2/1)*(h)^1*(De)^1+(-2/1)*(h)^1*(Dh)^1+(-2/1)*(z2)^1*(D2)^1+(1/1)*(z2)^1*(tl)^1*(D2)^1*(Dl)^1+(-2/1)*(z2)^1*(h)^1*(D2)^1*(De)^1+(-2/1)*(z2)^1*(h)^1*(D2)^1*(Dh)^1+(-2/1)*(z1)^1*(D1)^1+(1/1)*(z1)^1*(tl)^1*(D1)^1*(Dl)^1+(-2/1)*(z1)^1*(h)^1*(D1)^1*(De)^1+(-2/1)*(z1)^1*(h)^1*(D1)^1*(Dh)^1+(2/1)*(z1)^1*(z2)^1*(De)^1+(2/1)*(z1)^1*(z2)^1*(Dh)^1+(-2/1)*(z1)^1*(z2)^1*(D1)^1*(D2)^1+(3/1)*(z1)^1*(z2)^1*(tl)^1*(Dl)^1*(De)^1+(3/1)*(z1)^1*(z2)^1*(tl)^1*(Dh)^1*(Dl)^1+(1/1)*(z1)^1*(z2)^1*(tl)^1*(D1)^1*(D2)^1*(Dl)^1+(2/1)*(z1)^1*(z2)^1*(h)^1*(De)^2+(4/1)*(z1)^1*(z2)^1*(h)^1*(Dh)^1*(De)^1+(2/1)*(z1)^1*(z2)^1*(h)^1*(Dh)^2+(-2/1)*(z1)^1*(z2)^1*(h)^1*(D1)^1*(D2)^1*(De)^1+(-2/1)*(z1)^1*(z2)^1*(h)^1*(D1)^1*(D2)^1*(Dh)^1;poly EtaDifference=(1/1)+(4/1)*(te)^1*(De)^1+(1/1)*(te)^2*(De)^2+(4/1)*(tl)^1*(Dl)^1+(2/1)*(tl)^1*(te)^1*(Dl)^1*(De)^1+(1/1)*(tl)^2*(Dl)^2+(-2/1)*(h)^1*(D1)^1*(D2)^1+(1/1)*(h)^1*(te)^1*(Dh)^1*(De)^1+(-1/1)*(h)^1*(te)^1*(D1)^1*(D2)^1*(De)^1+(1/1)*(h)^1*(tl)^1*(Dh)^1*(Dl)^1+(-1/1)*(h)^2*(D1)^1*(D2)^1*(Dh)^1+(-1/1)*(z1)^1*(D1)^1+(-1/1)*(z1)^1*(h)^1*(D1)^1*(Dh)^1;
print("CHECK|ordinary_graph|"+string(reduce(OrdinaryDifference,G)));
ideal Rems;poly Remainder=reduce(EtaDifference,G);vector v;int k=0;poly H=0;
while(1){Rems[k+1]=Remainder;v=linSyzSolve(Rems);if(v!=0){break;}k++;Remainder=reduce(ES*Remainder,G);}
int j;for(j=1;j<=k+1;j++){H=H+v[j]*ES^(j-1);print("HCOEFF|"+string(j-1)+"|"+string(v[j]));}
poly EtaFinal=H*EtaDifference;print("CHECK|eta_graph|"+string(reduce(EtaFinal,G)));
matrix Witness=lift(J,ideal(OrdinaryDifference,EtaFinal));
for(j=1;j<=5;j++){emit(Witness[j,1],"ordinary_witness_"+string(j));emit(Witness[j,2],"eta_witness_"+string(j));}
print("STAGE_COMPLETE|second");quit;
