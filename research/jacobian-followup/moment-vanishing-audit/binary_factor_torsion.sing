ring rFACE_SAME=0,(d,e,f),wp(1,1,1);
option(redSB);
intvec weights=1,1,1;
ideal I=d^2*e + d^2*f + d*e^2 + 4*d*e*f + d*f^2 + e^2*f + e*f^2,-3*d^4*e^2 - 5*d^4*e*f - 3*d^4*f^2 - 5*d^3*e^3 - 18*d^3*e^2*f - 18*d^3*e*f^2 - 5*d^3*f^3 - 3*d^2*e^4 - 18*d^2*e^3*f - 33*d^2*e^2*f^2 - 18*d^2*e*f^3 - 3*d^2*f^4 - 5*d*e^4*f - 18*d*e^3*f^2 - 18*d*e^2*f^3 - 5*d*e*f^4 - 3*e^4*f^2 - 5*e^3*f^3 - 3*e^2*f^4,d^6*e^3 + 3*d^6*e^2*f + 3*d^6*e*f^2 + d^6*f^3 + 3*d^5*e^4 + 15*d^5*e^3*f + 24*d^5*e^2*f^2 + 15*d^5*e*f^3 + 3*d^5*f^4 + 3*d^4*e^5 + 24*d^4*e^4*f + 60*d^4*e^3*f^2 + 60*d^4*e^2*f^3 + 24*d^4*e*f^4 + 3*d^4*f^5 + d^3*e^6 + 15*d^3*e^5*f + 60*d^3*e^4*f^2 + 93*d^3*e^3*f^3 + 60*d^3*e^2*f^4 + 15*d^3*e*f^5 + d^3*f^6 + 3*d^2*e^6*f + 24*d^2*e^5*f^2 + 60*d^2*e^4*f^3 + 60*d^2*e^3*f^4 + 24*d^2*e^2*f^5 + 3*d^2*e*f^6 + 3*d*e^6*f^2 + 15*d*e^5*f^3 + 24*d*e^4*f^4 + 15*d*e^3*f^5 + 3*d*e^2*f^6 + e^6*f^3 + 3*e^5*f^4 + 3*e^4*f^5 + e^3*f^6;
print("FACE_SAME_START");ideal G=std(I);ideal m=d,e,f;ideal K=std(quotient(G,m));
print("FACE_SAME_FORWARD");print(size(reduce(K*m,G)));print("FACE_SAME_REVERSE");print(size(reduce(G,K)));
