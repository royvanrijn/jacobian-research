LIB "elim.lib";
ring rLQ_NONISO_D1=0,(d2,d3,h1),dp;
option(redSB);
ideal All=-112*d2^2 - 320*d2*h1^2 + 896*d2*h1 - 360*d2 - 640*d3*h1 + 1120*d3 - 112*h1^2 + 480*h1 - 495,96*d2^3 + 1008*d2^2*h1^2 - 1728*d2^2*h1 + 144*d2^2 + 2016*d2*d3*h1 - 2016*d2*d3 + 792*d2*h1^2 - 2736*d2*h1 + 2466*d2 + 1008*d3^2 - 448*d3*h1^3 + 2016*d3*h1^2 - 2520*d3*h1 + 672*d3 + 96*h1^3 - 549*h1^2 + 1080*h1 - 723,2816*d2^4 + 4096*d2^3*h1^2 - 90112*d2^3*h1 + 81152*d2^3 + 8192*d2^2*d3*h1 - 101376*d2^2*d3 + 45056*d2^2*h1^4 - 262144*d2^2*h1^3 + 451584*d2^2*h1^2 - 198656*d2^2*h1 - 20960*d2^2 - 22528*d2*d3^2 + 262144*d2*d3*h1^3 - 1155072*d2*d3*h1^2 + 1511424*d2*d3*h1 - 478720*d2*d3 + 26624*d2*h1^4 - 212992*d2*h1^3 + 590592*d2*h1^2 - 657920*d2*h1 + 235728*d2 + 270336*d3^2*h1^2 - 901120*d3^2*h1 + 760320*d3^2 - 8192*d3*h1^4 + 131072*d3*h1^3 - 583680*d3*h1^2 + 1026560*d3*h1 - 634304*d3 + 2816*h1^4 - 28672*h1^3 + 102592*h1^2 - 155520*h1 + 85227,-33280*d2^5 - 661760*d2^4*h1^2 + 1664000*d2^4*h1 - 629760*d2^4 - 1323520*d2^3*d3*h1 + 1830400*d2^3*d3 - 1464320*d2^3*h1^4 + 6983680*d2^3*h1^3 - 10343680*d2^3*h1^2 + 5351680*d2^3*h1 - 1410560*d2^3 - 549120*d2^2*d3^2 - 6420480*d2^2*d3*h1^3 + 23485440*d2^2*d3*h1^2 - 23591040*d2^2*d3*h1 + 4942080*d2^2*d3 - 1436160*d2^2*h1^4 + 9297920*d2^2*h1^3 - 20986080*d2^2*h1^2 + 18694080*d2^2*h1 - 4675760*d2^2 - 8785920*d2*d3^2*h1^2 + 24161280*d2*d3^2*h1 - 14551680*d2*d3^2 + 585728*d2*d3*h1^5 - 4055040*d2*d3*h1^4 + 6589440*d2*d3*h1^3 + 7912960*d2*d3*h1^2 - 28168800*d2*d3*h1 + 18271968*d2*d3 - 112640*d2*h1^5 + 713600*d2*h1^4 - 1125120*d2*h1^3 - 1323280*d2*h1^2 + 5051440*d2*h1 - 3599550*d2 - 3660800*d3^3*h1 + 6223360*d3^3 + 1464320*d3^2*h1^4 - 8785920*d3^2*h1^3 + 17571840*d3^2*h1^2 - 11897600*d3^2*h1 + 377520*d3^2 + 168960*d3*h1^5 - 1745920*d3*h1^4 + 6920320*d3*h1^3 - 13273920*d3*h1^2 + 12423400*d3*h1 - 4576000*d3 - 33280*h1^5 + 354080*h1^4 - 1502080*h1^3 + 3181375*h1^2 - 3363600*h1 + 1418895;
for(int kk=2;kk<=4;kk++){ideal I=0;for(int jj=1;jj<=kk;jj++){I=I,All[jj];}
print("LQ_NONISO_D1_GATE");print(2*(kk+1));ideal G=std(I);print("LQ_NONISO_D1_BASIS_SIZE");print(size(G));print("LQ_NONISO_D1_BASIS");print(G);
for(int pp=1;pp<=4;pp++){poly remainderPoly=reduce(d3^pp,G);print("LQ_NONISO_D1_POWER");print(pp);print(size(remainderPoly));if(remainderPoly==0){break;}}
ideal Sat=sat(G,ideal(d3));print("LQ_NONISO_D1_SATURATED");print(Sat);if(reduce(1,Sat)==0){break;}
}
print("END");quit;
