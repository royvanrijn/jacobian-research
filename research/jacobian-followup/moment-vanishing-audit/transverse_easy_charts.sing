LIB "elim.lib";
ring rTRANSVERSE_A0D1E1=0,(b,f),dp;
option(redSB);
ideal All=-5*b^2 - 20*b*f - 12*f^2 + 20,-f^3 - 7*f,11*b^4 + 88*b^3*f + 224*b^2*f^2 - 88*b^2 + 192*b*f^3 - 352*b*f + 48*f^4 - 144*f^2 + 176,55*b^2*f^3 + 429*b^2*f + 220*b*f^4 + 1716*b*f^2 + 120*f^5 + 704*f^3 - 1716*f;
poly delta=f;
for(int kk=2;kk<=4;kk++){
 ideal I=0;for(int jj=1;jj<=kk;jj++){I=I,All[jj];}
 ideal G=std(I);print("TRANSVERSE_A0D1E1_GATE");print(2*(kk+1));
 print("TRANSVERSE_A0D1E1_BASIS");print(G);
 poly remainderPoly=reduce(delta^12,G);print("TRANSVERSE_A0D1E1_DET_REMAINDER_SIZE");print(size(remainderPoly));
 ideal Sat=sat(G,ideal(delta));print("TRANSVERSE_A0D1E1_SATURATED");print(Sat);
 if(reduce(1,Sat)==0){break;}
}
ring rTRANSVERSE_DECOUPLED=0,(f),dp;
option(redSB);
ideal All=-7*f^4 - 38*f^3 - 108*f^2 - 90*f + 195,4*f^6 + 38*f^5 + 199*f^4 + 552*f^3 + 918*f^2 + 810*f + 1319,11*f^8 + 92*f^7 + 320*f^6 + 164*f^5 - 3130*f^4 - 13372*f^3 - 27864*f^2 - 21060*f + 34887,-260*f^10 - 3634*f^9 - 26613*f^8 - 120210*f^7 - 356970*f^6 - 664950*f^5 - 610292*f^4 + 201866*f^3 + 1093230*f^2 + 1295280*f + 4617705;
poly delta=-f^2 - 2*f - 5;
for(int kk=2;kk<=4;kk++){
 ideal I=0;for(int jj=1;jj<=kk;jj++){I=I,All[jj];}
 ideal G=std(I);print("TRANSVERSE_DECOUPLED_GATE");print(2*(kk+1));
 print("TRANSVERSE_DECOUPLED_BASIS");print(G);
 poly remainderPoly=reduce(delta^12,G);print("TRANSVERSE_DECOUPLED_DET_REMAINDER_SIZE");print(size(remainderPoly));
 ideal Sat=sat(G,ideal(delta));print("TRANSVERSE_DECOUPLED_SATURATED");print(Sat);
 if(reduce(1,Sat)==0){break;}
}
print("END");quit;
