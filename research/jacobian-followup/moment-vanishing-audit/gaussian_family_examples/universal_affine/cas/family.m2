load "/home/royvanrijn/src/jacobian-research/research/jacobian-followup/moment-vanishing-audit/gaussian_family_core.m2";
W=QQ[x0,t,c0,c1,dx0,dt,dc0,dc1,WeylAlgebra=>{x0=>dx0,t=>dt,c0=>dc0,c1=>dc1}];
P=sub((1)*c0^1+(1)*x0^1*c1^1,W);
I=ideal(dx0+((1)*x0)-t*diff(x0,P),dt-P,dc0-t*diff(c0,P),dc1-t*diff(c1,P));
if not isHolonomic(W^1/I) then error "exponential source not holonomic";
M=gQuotient Dintegration(0,I,{1,0,0,0});
stdio << "SOURCE_PRESENTATION|" << toString presentation M << endl;
B=QQ[c0,c1];
parameterIdeal=ideal matrix(B,{{0_B}});
R=gFamilySafeIdeal(M,B,parameterIdeal);
stdio << "RESULT_JSON|" << toJSON R << endl;
print("GAUSSIAN_FAMILY_COMPLETE");exit 0;
