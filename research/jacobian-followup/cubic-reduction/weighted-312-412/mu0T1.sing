ideal G=std(I);
if(size(G)!=1||G[1]!=1){print("NONUNIT");print(G);quit;}
matrix M=lift(I,ideal(1));
if((matrix(I)*M)[1,1]!=1){print("ERROR");quit;}
int i;poly pp;
