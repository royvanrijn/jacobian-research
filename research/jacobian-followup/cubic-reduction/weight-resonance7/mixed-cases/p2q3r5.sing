ring rr=0,(c0,c1,c2,c3,c4,c5,c6,c7),dp;
short=0;
ideal I=(7)*c1*c4*c7,(4)*c0*c4*c7+(15)*c1*c3*c7+(1)*c1*c4*c6,(12)*c0*c3*c7+(-2)*c0*c4*c6+(9)*c1*c3*c6+(-5)*c1*c4*c5,(6)*c0*c3*c6+(-8)*c0*c4*c5+(3)*c1*c3*c5,(-2)*c1*c2*c7,(-6)*c1*c2*c6+(6)*c1*c4+(6)*c1*c7+(3)*c4*c7,(-4)*c0*c2*c6+(8)*c0*c7+(-10)*c1*c2*c5+(12)*c1*c3+(2)*c1*c6+(6)*c3*c7,(-8)*c0*c2*c5+(6)*c0*c3+(4)*c0*c6+(-2)*c1*c5+(3)*c3*c6+(-3)*c4*c5,(-1)*c1*c2+(-1)*c2*c7,(-2)*c0*c2+(5)*c1+(-2)*c2*c6+(2)*c4+(2)*c7,(4)*c0+(-3)*c2*c5+(3)*c3+(1)*c6;
ideal G=std(I);
int i;int k;poly target;matrix M;poly pp;
k=1;target=c0;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c0^k;}
if(k>32){print("MISS:0");}else{
print("TARGET:0:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
k=1;target=c1;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c1^k;}
if(k>32){print("MISS:1");}else{
print("TARGET:1:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
quit;
