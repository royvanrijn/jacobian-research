ring rr=0,(c0,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10),dp;
short=0;
ideal I=(7)*c2*c6*c10,(8)*c1*c6*c10+(-2)*c2*c5*c10+(14)*c2*c6*c9,(9)*c0*c6*c10+(-1)*c1*c5*c10+(15)*c1*c6*c9+(-11)*c2*c4*c10+(5)*c2*c5*c9+(21)*c2*c6*c8,(16)*c0*c6*c9+(-10)*c1*c4*c10+(6)*c1*c5*c9+(22)*c1*c6*c8+(-20)*c2*c3*c10+(-4)*c2*c4*c9+(12)*c2*c5*c8,(-9)*c0*c4*c10+(7)*c0*c5*c9+(23)*c0*c6*c8+(-19)*c1*c3*c10+(-3)*c1*c4*c9+(13)*c1*c5*c8+(-13)*c2*c3*c9+(3)*c2*c4*c8,(-18)*c0*c3*c10+(-2)*c0*c4*c9+(14)*c0*c5*c8+(-12)*c1*c3*c9+(4)*c1*c4*c8+(-6)*c2*c3*c8,(-11)*c0*c3*c9+(5)*c0*c4*c8+(-5)*c1*c3*c8,(-4)*c0*c3*c8,(2)*c1*c6*c7+(-4)*c2*c5*c7+(7)*c2*c6+(2)*c2*c10+(6)*c6*c10,(4)*c0*c6*c7+(-2)*c1*c5*c7+(9)*c1*c6+(1)*c1*c10+(-8)*c2*c4*c7+(3)*c2*c5+(4)*c2*c9+(-1)*c5*c10+(12)*c6*c9,(11)*c0*c6+(-6)*c1*c4*c7+(5)*c1*c5+(3)*c1*c9+(-12)*c2*c3*c7+(-1)*c2*c4+(6)*c2*c8+(-8)*c4*c10+(5)*c5*c9+(18)*c6*c8,(-4)*c0*c4*c7+(7)*c0*c5+(2)*c0*c9+(-10)*c1*c3*c7+(1)*c1*c4+(5)*c1*c8+(-5)*c2*c3+(-15)*c3*c10+(-2)*c4*c9+(11)*c5*c8,(-8)*c0*c3*c7+(3)*c0*c4+(4)*c0*c8+(-3)*c1*c3+(-9)*c3*c9+(4)*c4*c8,(-1)*c0*c3+(-3)*c3*c8,(2)*c2+(-2)*c5*c7+(6)*c6+(1)*c10,(2)*c1+(-4)*c4*c7+(4)*c5+(2)*c9,(2)*c0+(-6)*c3*c7+(2)*c4+(3)*c8;
ideal G=std(I);
int i;int k;poly target;matrix M;poly pp;
k=1;target=c0;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c0^k;}
if(k>32){print("MISS:0");}else{
print("TARGET:0:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
