ring r=0,(u1,u2,v1,v2),dp;
short=0;
ideal I=(-1/2)*u1^2*u2+(1/2)*u1*u2^2+(-1/2)*v1^2*v2+(1/2)*v1*v2^2+(1/6),(1)*u1^3+(-1)*u1*u2^2+(1)*v1^3+(-1)*v1*v2^2+(-1/3),(1/2)*u1^2*u2+(1/2)*u1*u2^2+(1/2)*v1^2*v2+(1/2)*v1*v2^2+(1/6);
ideal G=std(I);
if(size(G)==1 && G[1]==1){print("UNIT");}else{print("PROPER");print(G);}
quit;
