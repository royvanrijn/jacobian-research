ring rr=0,(c1,c2,c4,c5,c6,c7,c8,c9,c10,c11),dp;
short=0;
ideal I=(7)*c2*c5*c10+(-21)*c2*c7*c8+(14)*c5*c8,(6)*c1*c5*c10+(-14)*c1*c7*c8+(5)*c2*c4*c10+(7)*c2*c5*c9+(-21)*c2*c6*c8+(7)*c4*c8,(14)*c2*c5*c11+(-14)*c2*c7*c10+(21)*c5*c10+(-7)*c7*c8,(4)*c1*c4*c10+(6)*c1*c5*c9+(-14)*c1*c6*c8+(5)*c2*c4*c9+(7)*c2*c5+(3)*c2*c10+(5)*c5*c10+(-7)*c7*c8,(12)*c1*c5*c11+(-8)*c1*c7*c10+(10)*c2*c4*c11+(-16)*c2*c6*c10+(-12)*c2*c7*c9+(12)*c4*c10+(22)*c5*c9+(-14)*c6*c8,(-7)*c2*c7*c11+(28)*c5*c11,(4)*c1*c4*c9+(6)*c1*c5+(2)*c1*c10+(5)*c2*c4+(3)*c2*c9+(3)*c4*c10+(5)*c5*c9+(-7)*c6*c8,(8)*c1*c4*c11+(-10)*c1*c6*c10+(-6)*c1*c7*c9+(-14)*c2*c6*c9+(-10)*c2*c7+(6)*c2*c11+(13)*c4*c9+(10)*c5*c11+(23)*c5+(-2)*c7*c10+(3)*c10,(-2)*c1*c7*c11+(-11)*c2*c6*c11+(17)*c4*c11+(-9)*c6*c10+(3)*c7*c9,(4)*c1*c4+(2)*c1*c9+(3)*c2+(3)*c4*c9+(5)*c5+(1)*c10,(7)*c7*c11,(-8)*c1*c6*c9+(-4)*c1*c7+(4)*c1*c11+(-12)*c2*c6+(6)*c4*c11+(14)*c4+(-4)*c6*c10+(4)*c9,(-6)*c1*c6*c11+(-6)*c6*c9+(3)*c7*c11+(6)*c7+(6)*c11,(2)*c1+(3)*c4+(1)*c9,(-4)*c6*c11,(-6)*c1*c6+(-2)*c6*c9+(2)*c7+(2)*c11+(5),(-1)*c6*c11+(-3)*c6;
ideal G=std(I);
if(size(G)!=1||G[1]!=1){print("NONUNIT");print(G);quit;}
