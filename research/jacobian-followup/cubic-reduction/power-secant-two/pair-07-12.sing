ring r=0,(u1,u2,u3,u4,v1,v2),dp;
short=0;
ideal I=(1)*u2^2*u3+(-1)*u3^3+(1)*u3*u4^2,(1)*u2^2*u3+(-1)*u2*u3^2,(1)*u1^3+(-1)*u1^2*u2+(-1)*u1*u4^2,(1)*u1^2*u3+(-1)*u1*u3^2,(1)*u1^2*u2+(-1)*u1*u2^2,(1)*u2*u3*u4,(1)*u1*u2*u4;
ideal J; ideal G;
J=I,(-1/2)*v1^2*v2+(1/2)*v1*v2^2+(1/6),(1)*v1^3+(-1)*v1*v2^2+(-1/3),(1/2)*v1^2*v2+(1/2)*v1*v2^2+(1/6);
