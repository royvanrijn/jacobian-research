ring r=0,(u1,u2,v1,v2),dp;
short=0;
ideal J; matrix M; matrix P; int h;
J=(-1/2)*u1^2*u2+(1/2)*u1*u2^2+(-1/2)*v1^2*v2+(1/2)*v1*v2^2+(1/6),(1)*u1^3+(-1)*u1*u2^2+(1)*v1^3+(-1)*v1*v2^2+(-1/3),(1/2)*u1^2*u2+(1/2)*u1*u2^2+(1/2)*v1^2*v2+(1/2)*v1*v2^2+(1/6);
M=lift(J,ideal(1));
P=matrix(J)*M;
if(P[1,1]!=1){print("ERROR");quit;}
print("CERT:4:5:6:3");
for(h=1;h<=nrows(M);h++){print(string(M[h,1]));}
quit;
