ring r=0,(u1,u2),dp;
option(redSB);
ideal I=0;
ideal J; ideal G;
J=I,-u1^2*u2/2 + u1*u2^2/2 - 1,u1^3 - u1*u2^2 + 2;
G=std(J);
if(size(G)==1 && G[1]==1){print("PASS:4:5");}else{print("OPEN:4:5");print(G);}
J=I,-u1^2*u2/2 + u1*u2^2/2 - 1,u1^2*u2/2 + u1*u2^2/2 - 1;
G=std(J);
if(size(G)==1 && G[1]==1){print("PASS:4:6");}else{print("OPEN:4:6");print(G);}
J=I,u1^3 - u1*u2^2 - 1,u1^2*u2/2 + u1*u2^2/2 + 1/2;
G=std(J);
if(size(G)==1 && G[1]==1){print("PASS:5:6");}else{print("OPEN:5:6");print(G);}
quit;
