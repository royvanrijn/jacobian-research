ring r=0,(u1,u2),dp;
option(redSB);
ideal I=0;
ideal J; ideal G;
J=I,-u1^2*u2/2 + u1*u2^2/2 - 1,u1^3 - u1*u2^2 + 2;
G=std(J);
if(size(G)==1 && G[1]==1){print("PASS:13:14");}else{print("OPEN:13:14");print(G);}
J=I,-u1^2*u2/2 + u1*u2^2/2 - 1,u1^2*u2/2 + u1*u2^2/2 - 1;
G=std(J);
if(size(G)==1 && G[1]==1){print("PASS:13:15");}else{print("OPEN:13:15");print(G);}
J=I,u1^3 - u1*u2^2 - 1,u1^2*u2/2 + u1*u2^2/2 + 1/2;
G=std(J);
if(size(G)==1 && G[1]==1){print("PASS:14:15");}else{print("OPEN:14:15");print(G);}
quit;
