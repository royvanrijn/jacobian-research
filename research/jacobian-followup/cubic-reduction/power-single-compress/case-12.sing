J=I,(-1/2)*u1^2*u2+(1/2)*u1*u2^2+(-1),(1/2)*u1^2*u2+(1/2)*u1*u2^2+(-1);
G=std(J);
if(size(G)==1 && G[1]==1){print("PASS:7:9");}else{print("OPEN:7:9");print(G);}
