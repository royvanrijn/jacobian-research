LIB "primdec.lib";
ring r=0,(u1,u2,u3,u4,u5,u6),dp;
short=0;
ideal I=(1)*u1*u3*u6,(1)*u2*u3*u6,(1)*u2*u4*u6,(1)*u2*u5*u6,(1)*u3*u4*u6,(1)*u3*u5*u6,(1)*u2^2*u3+(3)*u2*u3^2,(1)*u2^2*u4+(3/2)*u4^2*u5+(-27/2)*u5*u6^2,(1)*u4*u5*u6+(3/2)*u5^2*u6,(1)*u4^2*u5+(-9/4)*u5^3,(1)*u2^2*u4+(-9)*u4^3+(-12)*u4^2*u5+(9)*u4*u6^2,(1)*u4^2*u5+(3/2)*u4*u5^2,(1)*u3^2*u6+(-1)*u3*u6^2,(1)*u2^2*u4+(-27/4)*u3*u5^2,(1)*u2^2*u4+(9/2)*u3*u4*u5,(1)*u2^2*u4+(-3)*u3*u4^2,(1)*u2^2*u4+(27/2)*u3^2*u5,(1)*u2^2*u4+(-9)*u3^2*u4,(1)*u1^2*u2+(3)*u1^2*u3+(2)*u2^2*u3+(6)*u2*u3^2+(-1)*u2*u6^2,(1)*u2^2*u4+(9/4)*u2*u5^2,(1)*u2^2*u4+(-3/2)*u2*u4*u5,(1)*u2^2*u4+(1)*u2*u4^2,(1)*u2^2*u4+(-9/2)*u2*u3*u5,(1)*u2^2*u4+(3)*u2*u3*u4,(1)*u2^2*u4+(3/2)*u2^2*u5,(1)*u1^3+(1/9)*u1^2*u2+(1/3)*u1^2*u3+(1/9)*u1*u2^2+(2/3)*u1*u2*u3+(-1)*u1*u6^2,(1)*u1^2*u5+(1/2)*u1*u5^2,(1)*u1^2*u5+(-1/3)*u1*u4*u5,(1)*u1^2*u4+(-3)*u1^2*u5+(-1)*u1*u4^2,(1)*u1^2*u2+(3)*u1^2*u3+(1)*u1*u2^2+(3)*u1*u2*u3,(1)*u1*u2*u4+(-9/2)*u1*u3*u5,(1)*u1*u2*u4+(3)*u1*u3*u4,(1)*u1^2*u2+(3)*u1^2*u3+(1)*u1*u2^2+(6)*u1*u2*u3+(9)*u1*u3^2,(1)*u1*u2*u4+(3/2)*u1*u2*u5;
list L=minAssGTZ(I);
int a; int b; ideal P;
print("COUNT:"+string(size(L)));
for(a=1;a<=size(L);a++){P=L[a];print("PRIME:"+string(a)+":"+string(dim(std(P)))+":"+string(size(P)));for(b=1;b<=size(P);b++){print(string(P[b]));}}
quit;
