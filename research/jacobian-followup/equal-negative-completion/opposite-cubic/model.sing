ring R=0,(a0,a1,a2,a3,a4,a5,b0,b1,b2,b3,rho),dp;
option(redSB);
ideal I=-a3*b3 + 5*a5*b1,-2*a4*b3 + 10*a5*b2,-a1*b3 + 4*a2*b1 - 2*a3*b3 + 4*a5*b1 + 5*a5,8*a2*b2 + 4*a3*b1 - 4*a4*b3 + 8*a5*b2,3*a0*b1 - 2*a1*b3 + 3*a2*b1 + 4*a2 - a3*b0 + 4*a5,8*a3*b2 + 4*a4*b1,6*a0*b2 + 3*a1*b1 + 6*a2*b2 + 2*a3*b1 + 5*a3 - 2*a4*b0,2*a0*b1 + 3*a0 - a1*b0 + 3*a2 + 2*b1,8*a4*b2,6*a1*b2 + 5*a3*b2 + a4*b1 + 6*a4,4*a0*b2 + a1*b1 + 4*a1 + 3*a3 + 4*b2,2*a0 + b1 + 2,4*a4*b2,3*a1*b2 + 3*a4,2*a1 + 2*b2,a5*rho - 1;
ideal G=std(I);
print("GB_BEGIN");print(G);print("GB_END");
if(size(G)==1 && G[1]==1){print("UNIT_IDEAL");matrix M=lift(I,G);short=0;print("CERT_BEGIN");for(int i=1;i<=nrows(M);i++){print(string(i)+"|"+string(M[i,1]));}print("CERT_END");}
quit;
