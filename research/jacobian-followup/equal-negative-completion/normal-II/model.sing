ring R=0,(a0,a1,a2,a3,a4,a5,a6,a7,b0,b1,b2,b3,rho),dp;
option(redSB);
ideal I=-4*a4*b3 + 5*a7*b1,-8*a5*b3 + 10*a7*b2,-4*a1*b3 + 4*a3*b1 - 3*a4*b0 - 3*a4*b3 + 4*a7*b1,-12*a6*b3,-8*a2*b3 + 8*a3*b2 + a4*b1 - 6*a5*b0 - 6*a5*b3 + 8*a7*b2,3*a0*b1 - 3*a1*b0 - 3*a1*b3 + 3*a3*b1 - 2*a4*b0 - 2*a4 - 4*b3,5*a4*b2 - 2*a5*b1 - 9*a6*b0 - 9*a6*b3,6*a0*b2 - 6*a2*b0 - 6*a2*b3 + 6*a3*b2 + a4*b1 - 4*a5*b0 - 4*a5,2*a0*b1 - 2*a1*b0 - 2*a1 - a4 - 3*b0 - 3*b3,2*a5*b2 - 5*a6*b1,3*a1*b2 - 3*a2*b1 + 4*a4*b2 - a5*b1 - 6*a6*b0 - 6*a6,4*a0*b2 - 4*a2*b0 - 4*a2 - 2*a5 - b1,-a1 - 2*b0 - 2,-a6*b2,2*a5*b2 - 3*a6*b1,2*a1*b2 - 2*a2*b1 - 3*a6 + b2,-2*a2 - b1,a7*rho - 1;
ideal G=std(I);
print("GB_BEGIN");print(G);print("GB_END");
if(size(G)==1 && G[1]==1){print("UNIT_IDEAL");matrix M=lift(I,G);short=0;print("CERT_BEGIN");for(int i=1;i<=nrows(M);i++){print(string(i)+"|"+string(M[i,1]));}print("CERT_END");}
quit;
