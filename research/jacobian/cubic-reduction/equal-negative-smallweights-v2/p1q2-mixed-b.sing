ring rr=0,(q0,q1,s,t,h,r,rho),dp;
short=0;
ideal I=(-2/1)*q0*r+(-9/1)*q1^2,(-12/1)*q0*q1+(-4/1)*s*r,(-6/1)*q0^2+(4/1)*q1*s+(5/1)*t+(3/1)*h,(-8/1)*q1*s*r+(-4/1)*t*r,(-8/1)*q0*s*r+(12/1)*q1^2*s+(-3/1)*q1*t+(9/1)*q1*h,(12/1)*q0*q1*s+(-9/1)*q0*t+(5/1)*q0*h,(-12/1)*s*t*r,(18/1)*q1*s*t+(2/1)*q1*s*h+(7/1)*t*h,(1/1)*s*t*h*rho+(-1/1);
matrix M=lift(I,ideal(1));
matrix CC=matrix(I)*M;
if(CC[1,1]!=1){print("ERROR");quit;}
int i;poly pp;
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
quit;
