ring r=0,(c7,c9,c12,c13,c14,c16,c18,c19,c20),dp;
short=0;
ideal I=(-1)*c14*c19,(2)*c14*c19,(-1)*c14*c19,(-2)*c14*c16+(2)*c19*c9,(3)*c13*c9+(3)*c14*c16+(-2)*c19*c9+(-1)*c19,(-3)*c13*c9+(-1)*c14*c16+(1)*c19,(9)*c12*c19+(-4)*c14*c20,(9)*c12*c13+(-6)*c12*c19+(-3)*c14^2+(6)*c14*c20+(6)*c19*c7,(-6)*c12*c13+(6)*c13*c7+(4)*c14^2+(-2)*c14*c20+(-1)*c16*c9+(-2)*c16+(-3)*c19*c7,(-3)*c13*c7+(-1)*c14^2+(1)*c16,(6)*c12*c16+(-5)*c14*c18+(-3)*c20*c9,(-4)*c12*c16+(7)*c14*c18+(-2)*c14*c9+(-4)*c14+(4)*c16*c7+(1)*c20*c9+(-4)*c20,(-2)*c14*c18+(2)*c14+(-2)*c16*c7+(2)*c20,(3)*c12*c20,(3)*c12*c14+(-2)*c12*c20+(-5)*c18*c9+(2)*c20*c7,(-2)*c12*c14+(2)*c14*c7+(2)*c18*c9+(-5)*c18+(-1)*c20*c7+(-4)*c9,(-1)*c14*c7+(2)*c18+(1)*c9+(-4);
matrix M=lift(I,ideal(1));
matrix Check=matrix(I)*M;
if(Check[1,1]!=1){print("ERROR");quit;}
int i; poly q;
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));q=M[i,1];while(q!=0){print("COEF:"+string(leadcoef(q)));print("EXP:"+string(leadexp(q)));q=q-lead(q);}print("END");}
quit;
