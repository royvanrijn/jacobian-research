ring r=0,(T,P,beta),dp;
short=0;
ideal I=(-1/3)*P*beta^3+(-1)*P*beta^2+(1)*T*beta^3+(-8/3)*beta^2+(-40/3)*beta+(-16),(1)*P*beta^2+(-3)*beta^2+(-9)*beta+(-8),(1)*T*beta+(2)*T,(1/3)*P*beta^3+(2/3)*P*beta^2+(1)*T*beta^3+(-4/3)*beta^3+(-20/3)*beta^2+(-32/3)*beta+(-16/3),(1)*P*beta^2+(-5/2)*beta^2+(-6)*beta+(-2);
matrix M=lift(I,ideal(1));
matrix Check=matrix(I)*M;
if(Check[1,1]!=1){print("ERROR");quit;}
int i; poly q;
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));q=M[i,1];while(q!=0){print("COEF:"+string(leadcoef(q)));print("EXP:"+string(leadexp(q)));q=q-lead(q);}print("END");}
quit;
