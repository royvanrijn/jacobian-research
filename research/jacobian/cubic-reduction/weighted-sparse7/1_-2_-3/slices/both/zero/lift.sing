ring r=0,(c4,c5,c6,c7,c8,c9,c10,c11,c12,c13),dp;
short=0;
ideal I=(-1)*c13*c8,(-1)*c13*c7,(-3/5)*c12*c8+(-1)*c13*c8,(15/8)*c11*c8+(-3/2)*c12*c7+(-1/4)*c13*c6+(-1)*c13*c7,(5)*c10*c8+(5)*c11*c8+(-3)*c12*c6+(-6)*c12*c7+(2)*c13*c5+(-1)*c13*c6,(-2)*c10*c7+(5/2)*c11*c6+(-1)*c11*c7,(-5/4)*c10*c8+(3/2)*c12*c6+(-1)*c13*c5+(3/4)*c13*c8+(-5/4)*c8*c9,(-1/3)*c10*c6+(2)*c10*c7+(-10/3)*c11*c5+(-1)*c11*c6+(2)*c13*c4+(-4/3)*c13*c7+(8/3)*c7*c9,(2)*c10*c5+(-1/3)*c10*c6+(8/3)*c11*c5+(-2)*c11*c8+(-3)*c12*c4+(2)*c12*c7+(-1)*c13*c4+(1/3)*c13*c6+(-1)*c6*c9+(-10/3)*c7*c9+(4)*c8,(2/3)*c10*c5+(-1/2)*c10*c8+(-1)*c12*c4+(1/2)*c12*c6+(-1/2)*c12+(-1/3)*c13*c5+(1/2)*c13+(1/3)*c5*c9+(-5/6)*c6*c9+(5/6)*c8,(3)*c10*c4+(-2)*c10*c7+(-1)*c11*c4+(2)*c11*c6+(-5)*c11+(-4)*c6+(4)*c7,(-1)*c10*c4+(1)*c10+(-2)*c11*c5+(3)*c11+(1)*c13*c4+(-3)*c4*c9+(4)*c5+(2)*c7*c9,(-2/5)*c10*c5+(3/5)*c10+(3/5)*c12*c4+(-1/5)*c13+(-1)*c4*c9+(4/5)*c5+(2/5)*c6*c9+(-3/5)*c8+(-1/5)*c9,(1)*c10*c4+(-2)*c11+(-1)*c4+(-1)*c6+(4),(1/3)*c10+(-2/3)*c4*c9+(2/3)*c5+(-1);
matrix M=lift(I,ideal(1));
matrix Check=matrix(I)*M;
if(Check[1,1]!=1){print("ERROR");quit;}
int i; poly q;
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));q=M[i,1];while(q!=0){print("COEF:"+string(leadcoef(q)));print("EXP:"+string(leadexp(q)));q=q-lead(q);}print("END");}
quit;
