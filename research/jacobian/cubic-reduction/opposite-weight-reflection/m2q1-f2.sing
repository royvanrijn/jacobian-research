ring rr=0,(f0,f1,f2,g0,g1,g2,h0,h1,h2,k0,k1,rho),dp;
short=0;
ideal I=(2/1)*f0+(3/1)*g0+(1/1)*h0,(4/1)*f0*g0+(2/1)*f0*h0+(3/1)*f2+(3/1)*g0*h0+(-2/1)*g1*k0+(5/1)*g2+(1/1)*h2,(4/1)*f0*g0*h0+(-4/1)*f0*g1*k0+(6/1)*f0*g2+(2/1)*f0*h2+(2/1)*f1*g0*k0+(-1/1)*f1*k1+(5/1)*f2*g0+(3/1)*f2*h0+(3/1)*g0*h2+(-4/1)*g1*k1+(5/1)*g2*h0,(4/1)*f0*g0*h2+(-6/1)*f0*g1*k1+(6/1)*f0*g2*h0+(1/1)*f1*g0*k1+(4/1)*f1*g2*k0+(5/1)*f2*g0*h0+(-6/1)*f2*g1*k0+(7/1)*f2*g2+(3/1)*f2*h2+(5/1)*g2*h2,(6/1)*f0*g2*h2+(3/1)*f1*g2*k1+(5/1)*f2*g0*h2+(-8/1)*f2*g1*k1+(7/1)*f2*g2*h0,(7/1)*f2*g2*h2,(3/1)*f1+(3/1)*g1+(2/1)*h1,(2/1)*f0*g1+(4/1)*f0*h1+(7/1)*f1*g0+(2/1)*f1*h0+(6/1)*g0*h1+(1/1)*g1*h0,(8/1)*f0*g0*h1+(6/1)*f1*g0*h0+(-2/1)*f1*g1*k0+(11/1)*f1*g2+(1/1)*f1*h2+(1/1)*f2*g1+(6/1)*f2*h1+(-1/1)*g1*h2+(10/1)*g2*h1,(-2/1)*f0*g1*h2+(12/1)*f0*g2*h1+(5/1)*f1*g0*h2+(-5/1)*f1*g1*k1+(10/1)*f1*g2*h0+(10/1)*f2*g0*h1+(-1/1)*f2*g1*h0,(9/1)*f1*g2*h2+(-3/1)*f2*g1*h2+(14/1)*f2*g2*h1,(5/1)*f1*g1+(4/1)*f1*h1+(4/1)*g1*h1,(4/1)*f0*g1*h1+(10/1)*f1*g0*h1+(2/1)*f1*g1*h0,(-1/1)*f1*g1*h2+(16/1)*f1*g2*h1+(4/1)*f2*g1*h1,(6/1)*f1*g1*h1,(1/1)*f2*rho+(-1/1);
matrix M=lift(I,ideal(1));
matrix CC=matrix(I)*M;
if(CC[1,1]!=1){print("ERROR");quit;}
int i;poly pp;
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
quit;
