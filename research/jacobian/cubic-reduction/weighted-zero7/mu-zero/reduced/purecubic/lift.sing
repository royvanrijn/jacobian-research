ring r=0,(g6,g8,h5,h7,h9,f1,branch_inv),dp;
short=0;
ideal I=(7)*f1^3*g6*h9,(6)*f1^3*g8*h9,(-1)*f1^2*g6*h7,(-18)*f1^2*g6*h9,(8)*f1^2*g6*h9+(-3)*f1^2*g6+(2)*f1^2*g8*h7+(-4)*f1^2*h9,(-12)*f1^2*g8*h9,(9)*f1^2*g8*h9+(-2)*f1*g6*h5,(2)*f1*g6*h7,(-4)*f1*g8*h5+(2)*f1*h7,(15)*f1*g6*h9,(-10)*f1*g6*h9+(6)*f1*g6+(-4)*f1*g8*h7+(8)*f1*h9,(3)*f1*g6*h9+(-1)*f1*g6+(1)*f1*g8*h7+(-2)*f1*h9+(3)*f1,(6)*f1*g8*h9,(-9)*f1*g8*h9+(2)*g6*h5,(3)*f1*g8*h9+(-2)*g6*h5,(-1)*g6*h7,(4)*g8*h5+(-2)*h7,(-2)*g8*h5+(1)*h7,(-4)*g6*h9,(2)*g6*h9+(-3)*g6+(2)*g8*h7+(-4)*h9,(1)*g6+(-1)*g8*h7+(2)*h9+(-3),(-1)*branch_inv*f1+(1);
matrix M=lift(I,ideal(1));
matrix Check=matrix(I)*M;
if(Check[1,1]!=1){print("ERROR");quit;}
int i; poly q;
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));q=M[i,1];while(q!=0){print("COEF:"+string(leadcoef(q)));print("EXP:"+string(leadexp(q)));q=q-lead(q);}print("END");}
quit;
