ring rr=0,(c0,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10),dp;
short=0;
ideal I=(7)*c2*c6*c10,(-10)*c2*c5*c10,(2)*c1*c6*c10+(23)*c2*c4*c10+(-5)*c2*c6*c9,(6)*c0*c6*c10+(-12)*c1*c5*c10+(6)*c2*c3*c10+(-18)*c2*c5*c9+(6)*c2*c6*c8,(-8)*c0*c5*c10+(-7)*c2*c5*c8,(18)*c1*c4*c10+(-10)*c1*c6*c9+(11)*c2*c4*c9,(19)*c0*c4*c10+(-5)*c0*c6*c9+(4)*c1*c3*c10+(-20)*c1*c5*c9+(-2)*c2*c3*c9+(18)*c2*c4*c8+(-6)*c2*c6*c7,(5)*c0*c3*c10+(-15)*c0*c5*c9+(5)*c0*c6*c8+(-10)*c1*c5*c8+(5)*c2*c3*c8+(-15)*c2*c5*c7+(5)*c2*c6+(5)*c2*c10+(5)*c6*c10,(-5)*c0*c5*c8+(-4)*c2*c5+(-6)*c5*c10,(6)*c1*c4*c9,(8)*c0*c4*c9+(-4)*c1*c3*c9+(12)*c1*c4*c8+(-12)*c1*c6*c7+(6)*c2*c4*c7,(-2)*c0*c3*c9+(14)*c0*c4*c8+(-6)*c0*c6*c7+(2)*c1*c3*c8+(-18)*c1*c5*c7+(-2)*c1*c6+(6)*c1*c10+(-3)*c2*c3*c7+(13)*c2*c4+(1)*c2*c9+(15)*c4*c10+(-5)*c6*c9,(4)*c0*c3*c8+(-12)*c0*c5*c7+(4)*c0*c6+(4)*c0*c10+(-8)*c1*c5+(4)*c2*c3+(4)*c2*c8+(4)*c3*c10+(-12)*c5*c9+(4)*c6*c8,(-2)*c0*c5+(-3)*c5*c8,(3)*c0*c4*c7+(-6)*c1*c3*c7+(6)*c1*c4+(2)*c1*c9+(5)*c4*c9,(-3)*c0*c3*c7+(9)*c0*c4+(1)*c0*c9+(4)*c1*c8+(-2)*c3*c9+(10)*c4*c8+(-6)*c6*c7,(3)*c0*c3+(3)*c0*c8+(3)*c2+(3)*c3*c8+(-9)*c5*c7+(3)*c6+(3)*c10,(2)*c1+(-3)*c3*c7+(5)*c4+(1)*c9,(2)*c0+(2)*c3+(2)*c8;
