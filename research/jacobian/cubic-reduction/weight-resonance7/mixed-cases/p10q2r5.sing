ring rr=0,(c0,c1,c2,c3,c4,c5,c6,c7,c8),dp;
short=0;
ideal I=(7)*c2*c5*c8,(42)*c2*c4*c8+(-21)*c2*c5*c7,(6)*c0*c5*c8+(7)*c2*c3*c8+(5)*c2*c5*c6,(35)*c1*c4*c8+(-28)*c1*c5*c7+(14)*c2*c4*c7,(36)*c0*c4*c8+(-20)*c0*c5*c7+(5)*c1*c3*c8+(-4)*c1*c5*c6+(-11)*c2*c3*c7+(30)*c2*c4*c6,(6)*c0*c3*c8+(4)*c0*c5*c6+(5)*c2*c3*c6+(3)*c2*c5+(7)*c2*c8+(5)*c5*c8,(7)*c1*c4*c7,(10)*c0*c4*c7+(-13)*c1*c3*c7+(21)*c1*c4*c6,(-10)*c0*c3*c7+(24)*c0*c4*c6+(1)*c1*c3*c6+(-8)*c1*c5+(10)*c1*c8+(18)*c2*c4+(-1)*c2*c7+(30)*c4*c8+(-19)*c5*c7,(4)*c0*c3*c6+(2)*c0*c5+(6)*c0*c8+(3)*c2*c3+(5)*c2*c6+(5)*c3*c8+(3)*c5*c6,(7)*c1*c4+(2)*c1*c7+(6)*c4*c7,(12)*c0*c4+(-3)*c1*c3+(6)*c1*c6+(-9)*c3*c7+(18)*c4*c6,(2)*c0*c3+(4)*c0*c6+(3)*c2+(3)*c3*c6+(1)*c5+(5)*c8,(2)*c1+(6)*c4+(1)*c7,(2)*c0+(1)*c3+(3)*c6;
ideal G=std(I);
int i;int k;poly target;matrix M;poly pp;
k=1;target=c0;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c0^k;}
if(k>32){print("MISS:0");}else{
print("TARGET:0:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
k=1;target=c1;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c1^k;}
if(k>32){print("MISS:1");}else{
print("TARGET:1:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
k=1;target=c2;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c2^k;}
if(k>32){print("MISS:2");}else{
print("TARGET:2:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
quit;
