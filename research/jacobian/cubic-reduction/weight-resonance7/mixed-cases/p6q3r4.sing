ring rr=0,(c0,c1,c2,c3,c4,c5,c6,c7,c8),dp;
short=0;
ideal I=(7)*c2*c5*c8,(9)*c1*c5*c8+(-17)*c2*c4*c8+(28)*c2*c5*c7,(-15)*c1*c4*c8+(30)*c1*c5*c7+(4)*c2*c4*c7,(6)*c1*c4*c7,(6)*c0*c5*c8+(5)*c2*c3*c8+(7)*c2*c5*c6,(-14)*c0*c4*c8+(24)*c0*c5*c7+(3)*c1*c3*c8+(12)*c1*c5*c6+(20)*c2*c3*c7+(-11)*c2*c4*c6,(4)*c0*c4*c7+(18)*c1*c3*c7+(-6)*c1*c4*c6,(4)*c0*c3*c8+(6)*c0*c5*c6+(5)*c2*c3*c6+(7)*c2*c5+(3)*c2*c8+(5)*c5*c8,(16)*c0*c3*c7+(-8)*c0*c4*c6+(6)*c1*c3*c6+(15)*c1*c5+(-3)*c1*c8+(-5)*c2*c4+(12)*c2*c7+(-11)*c4*c8+(20)*c5*c7,(3)*c1*c4+(6)*c1*c7+(4)*c4*c7,(4)*c0*c3*c6+(6)*c0*c5+(2)*c0*c8+(5)*c2*c3+(3)*c2*c6+(3)*c3*c8+(5)*c5*c6,(-2)*c0*c4+(8)*c0*c7+(9)*c1*c3+(12)*c3*c7+(-5)*c4*c6,(4)*c0*c3+(2)*c0*c6+(3)*c2+(3)*c3*c6+(5)*c5+(1)*c8,(3)*c1+(1)*c4+(4)*c7,(2)*c0+(3)*c3+(1)*c6;
ideal G=std(I);
int i;int k;poly target;matrix M;poly pp;
k=1;target=c0;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c0^k;}
if(k>32){print("MISS:0");}else{
print("TARGET:0:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
k=1;target=c1;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c1^k;}
if(k>32){print("MISS:1");}else{
print("TARGET:1:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
k=1;target=c2;
while(k<=32 && reduce(target,G)!=0){k=2*k;target=c2^k;}
if(k>32){print("MISS:2");}else{
print("TARGET:2:"+string(k));
M=lift(I,ideal(target));
if((matrix(I)*M)[1,1]!=target){print("ERROR");quit;}
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));pp=M[i,1];while(pp!=0){print("COEF:"+string(leadcoef(pp)));print("EXP:"+string(leadexp(pp)));pp=pp-lead(pp);}print("END");}
}
quit;
