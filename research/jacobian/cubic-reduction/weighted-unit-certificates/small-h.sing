ring r=0,(g4,g5,g6,g7,g8,h5,h7,beta,sat),dp;
short=0;
ideal I=(1)*g4*h7+(1)*g5*h5+(-3)*g5*h7+(-3)*g6*h7+(9)*g7*h7,(1)*g4*h7+(-2)*g4+(2/3)*g5*h5+(-3/2)*g5*h7+(6)*g5+(-1/3)*g6*h5+(-3/2)*g6*h7+(6)*g6+(-1)*g7*h5+(9/2)*g7*h7+(-18)*g7,(1)*g4*h7+(-5)*g4+(2/3)*g5*h5+(-1)*g5*h7+(33/2)*g5+(-1/3)*g6*h5+(-1)*g6*h7+(15)*g6+(-4)*g7*h5+(3/2)*g7*h7+(-45)*g7,(1)*g4*h7+(-9)*g4+(27/2)*g5+(-1)*g6*h5+(27/2)*g6+(-81/2)*g7+(6)*g8*h5+(-3)*h7,(1)*g4+(-1/6)*g5*h7+(-5)*g5+(-1/6)*g6*h7+(-3)*g6+(1)*g7*h5+(5/2)*g7*h7+(9)*g7,(1)*g4+(-3/2)*g5+(-3/4)*g6+(1/2)*g7*h5+(9/4)*g7+(-1/2)*g8*h5+(-3/4)*g8*h7+(1/4)*h7,(1)*g4+(-1)*g8*h5+(1/2)*h7+(-3),(1)*g5+(-1)*g7*h7,(1)*g5+(-3)*g6+(-2)*g7*h7+(9)*g7+(2)*g8*h7,(1)*g6+(-1)*g8*h7+(3)*g8+(-3),(1)*beta*g5+(1)*beta*g6+(-6)*beta*g7+(-3)*beta*g8+(-1)*g7+(-1)*g8,(1)*beta*sat+(-1);
matrix M=lift(I,ideal(1));
matrix Check=matrix(I)*M;
if(Check[1,1]!=1){print("ERROR");quit;}
int i; poly q;
for(i=1;i<=nrows(M);i++){print("GEN:"+string(i));q=M[i,1];while(q!=0){print("COEF:"+string(leadcoef(q)));print("EXP:"+string(leadexp(q)));q=q-lead(q);}print("END");}
quit;
