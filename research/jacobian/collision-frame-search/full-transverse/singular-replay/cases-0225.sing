for(i=1;i<=size(P);i++){q=P[i];if(q!=0){
for(j=1;j<=size(B);j++){
while(deg(q)>=deg(B[j]) && reduce(q,ideal(B[j]))==0){q=q/B[j];}
}
require(q!=0 && deg(q)==0,"complete specialized factors");
}}
for(i=1;i<=size(B);i++){count=0;
for(j=1;j<=size(P);j++){if(reduce(P[j],ideal(B[i]))==0){count++;}}
current=111-count;
if(current<best){best=current;}
}
require(best==52,"minimum 249");
print("CASE|249|"+string(best));
kill K24;
exit;
