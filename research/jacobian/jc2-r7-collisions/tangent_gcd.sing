ring R=(0,d),(v),dp; minpoly=3761479876608*d^18 + 15898976317440*d^15 + 25767272444544*d^12 + 20621286822727*d^9 + 8479009232730*d^6 + 1615258153728*d^3 + 91424858112;
poly f=-64*d^4*v + 240*d^3*v^3 + 32*d^3 + 756*d^2*v^5 - 432*d^2*v^2 + 621*d*v^7 - 702*d*v^4 + 168*d*v + 162*v^9 - 270*v^6 + 126*v^3 - 14;
poly g=-64*d^4 + 720*d^3*v^2 + 3780*d^2*v^4 - 864*d^2*v + 4347*d*v^6 - 2808*d*v^3 + 168*d + 1458*v^8 - 1620*v^5 + 378*v^2;
