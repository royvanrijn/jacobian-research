ring rr=0,(a,b),dp;
short=0;
option(redSB);
ideal I=6*a^4 + 12*a^3 + 7*a^2 - 2*a*b + a - b,-16*a^5 - 40*a^4 - 32*a^3 + 8*a^2*b - 11*a^2 + 8*a*b - 5*a,16*a^6 + 48*a^5 + 52*a^4 - 16*a^3*b + 38*a^3 - 24*a^2*b + 29*a^2 - 8*a*b + 11*a + 4*b^2 - 2*b;
matrix L=lift(I,ideal(a,b));
print("BEGIN_MULTIPLIERS");
int i,j;
for (i=1;i<=nrows(L);i++) { for (j=1;j<=ncols(L);j++) { print(string(L[i,j])); } }
print("END_MULTIPLIERS");
quit;
