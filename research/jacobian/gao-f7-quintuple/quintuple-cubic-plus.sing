ring rr=0,(a,b,s),dp;
short=0;
option(redSB);
ideal I=810*a^3*s^2 + 1215*a^2*s^2 - 81*a^2*s + 324*a*b + 675*a*s^2 + 99*a*s + 108*b^2*s^2 - 162*b*s^2 + 222*b + 135*s^2 + 88*s - 54,-216*a^3*s - 1116*a^2*b - 1254*a^2*s + 189*a^2 + 756*a*b*s^2 - 1116*a*b - 678*a*s + 453*a - 432*b^2*s - 162*b*s^2 + 54*b*s - 324*b - 90*s^2 - 90*s + 37,6075*a^4*s + 12150*a^3*s - 1782*a^3 + 6480*a^2*b*s^2 + 972*a^2*s^2 + 10125*a^2*s - 2223*a^2 + 3456*a*b^2*s + 12240*a*b*s^2 + 2430*a*s^2 + 4050*a*s + 899*a + 1728*b^2*s + 864*b^2 + 2826*b*s^2 + 36*b*s + 162*b + 222*s^2 + 486*s + 205,3*s^3 - 1;
matrix L=lift(I,ideal(1));
print("BEGIN_MULTIPLIERS");
int i,j;
for (i=1;i<=nrows(L);i++) { for (j=1;j<=ncols(L);j++) { print(string(L[i,j])); } }
print("END_MULTIPLIERS");
quit;
