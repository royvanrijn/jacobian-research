ring R=0,(B,c,a),dp;
option(redSB);
poly f3=12*B*a - 10*a^2 + 15*c;
poly f5=-192*B*a^2 + 36*B*c + 160*a^3 - 270*a*c - 7;
poly f7=144*B*a^3 - 72*B*a*c + 6*B - 120*a^4 + 240*a^2*c - 10*a - 90*c^2;
poly f9=-432*B*a^2*c - 528*B*a + 216*B*c^2 + 360*a^3*c + 640*a^2 - 180*a*c^2 - 555*c;
ideal I=f3,f5,f7,f9;
ideal G=slimgb(I);
print("BASIS "+string(G));
matrix M=lift(I,ideal(1));
short=0;
int i;for(i=1;i<=4;i++){print("CERT "+string(i)+" "+string(M[i,1]));}
quit;
