#!/usr/bin/env sage
"""Complete five-octad M24 prefixes by two octads in N(24A1).

This is an exact, sharded enumeration of the octad-generated subfamily.  It
does not assert that every primitive rank-seven sublattice of N(24A1) is
generated by seven octad glue vectors.  Each shard is indexed by the exact
M24 orbit list produced by ``enumerate_24a1_octad_prefix_orbits.sage``.

The determinant calculation is vectorized, but every retained span is
saturated in an integral Construction-A basis.  Raw determinants above the
requested bound are not discarded until modular rank tests prove that their
span is primitive.  Pair candidates are first divided by the stabilizer of
their five-prefix, then final seven-sets are identified only by an exact M24
transporter.

status: EXACT_FINITE_SHARD_ENUMERATION_OF_DECLARED_OCTAD_SUBFAMILY
"""

import argparse
import hashlib
import json
import math
from collections import Counter, defaultdict
from pathlib import Path

import numpy as np
from sage.all import (
    GF,
    QQ,
    Genus,
    Graph,
    Permutation,
    PermutationGroup,
    QuadraticForm,
    Set,
    ZZ,
    identity_matrix,
    libgap,
    matrix,
    pari,
    prime_range,
    vector,
)
from sage.coding.golay_code import GolayCode
from sage.quadratic_forms.genera.genus import genera


HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
DEFAULT_PREFIX = (
    ROOT / "artifacts/generated-results/elkies-k3-24a1-octad-prefix-orbits-v1.json"
)


def rows(value):
    return [list(map(int, row)) for row in value.rows()]


def rows_as_strings(value):
    return [[str(entry) for entry in row] for row in value.rows()]


def discriminant_form_key(genus):
    normal = genus.discriminant_form().normal_form()
    return {
        "invariants": list(map(int, normal.invariants())),
        "quadratic_gram": rows_as_strings(normal.gram_matrix_quadratic()),
        "value_module": str(normal.value_module_qf()),
    }


def mask(word):
    return sum(1 << index for index, entry in enumerate(word) if entry)


def image_mask(value, permutation):
    result = 0
    for coordinate in range(24):
        if (value >> coordinate) & 1:
            result |= 1 << (permutation(coordinate + 1) - 1)
    return result


def construction_a_model():
    code = GolayCode(GF(2), extended=True)
    generator = code.generator_matrix().echelon_form()
    assert generator[:, :12] == identity_matrix(GF(2), 12)
    physical_basis = matrix(QQ, 24, 24)
    for index in range(12):
        physical_basis[index] = vector(
            QQ, [QQ(int(entry)) / 2 for entry in generator[index]]
        )
    for index in range(12):
        physical_basis[12 + index, 12 + index] = 1
    ambient_gram = physical_basis * (2 * identity_matrix(QQ, 24)) * physical_basis.transpose()
    ambient_gram = matrix(ZZ, ambient_gram)
    assert ambient_gram.det() == 1
    return code, physical_basis, ambient_gram


def build_action(code, octads):
    octad_index = {value: position + 1 for position, value in enumerate(octads)}
    coordinate_group = code.permutation_automorphism_group()
    assert coordinate_group.order() == 244823040
    induced_generators = []
    for generator in coordinate_group.gens():
        induced_generators.append(
            Permutation([octad_index[image_mask(value, generator)] for value in octads])
        )
    group = PermutationGroup(induced_generators, domain=range(1, 760))
    assert group.order() == 244823040
    return group


def octad_ambient_coordinates(value, inverse_physical_basis):
    physical = vector(
        QQ, [QQ(1) / 2 if (value >> index) & 1 else 0 for index in range(24)]
    )
    coordinates = physical * inverse_physical_basis
    assert all(entry in ZZ for entry in coordinates)
    return list(map(int, coordinates))


def primitive_closure(basis):
    saturated = basis.row_module(ZZ).saturation().basis_matrix()
    change = basis * saturated.pseudoinverse()
    assert all(entry.denominator() == 1 for entry in change.list())
    index = abs(int(matrix(ZZ, change).det()))
    return saturated, index


def canonical_edge_key(selected, relation):
    graph = Graph(len(selected))
    for left in range(len(selected)):
        for right in range(left + 1, len(selected)):
            graph.add_edge(left, right, int(relation[selected[left], selected[right]]))
    canonical = graph.canonical_label(edge_labels=True)
    return tuple(
        int(label)
        for unused_left, unused_right, label in canonical.edges(sort=True, labels=True)
    )


def invariant_signature(selected, octads, relation):
    union = 0
    for index in selected:
        union |= octads[index]
    values = np.sort(relation[np.array(selected), :], axis=0)
    codes = np.zeros(759, dtype=np.int64)
    for row in values:
        codes = 5 * codes + row
    histogram = tuple(map(int, np.bincount(codes, minlength=5 ** len(selected))))
    return canonical_edge_key(selected, relation), union.bit_count(), histogram


def equivalent(group_gap, left, right):
    return (
        libgap.RepresentativeAction(
            group_gap,
            libgap.Set([entry + 1 for entry in left]),
            libgap.Set([entry + 1 for entry in right]),
            libgap.OnSets,
        )
        != libgap.fail
    )


def quotient_projective_labels(prefix_rows, all_rows, prime):
    rref = matrix(GF(prime), prefix_rows.tolist()).echelon_form()
    rank = rref.rank()
    if rank != 5:
        return rank, np.zeros(len(all_rows), dtype=np.int64)
    pivots = list(rref.pivots())
    rref_array = np.array(
        [[int(entry) for entry in row] for row in rref.rows()], dtype=np.int64
    )
    reduced = all_rows % prime
    reduced = (reduced - reduced[:, pivots] @ rref_array) % prime
    labels = np.empty(len(all_rows), dtype=np.int64)
    keys = {}
    for index, row in enumerate(reduced):
        nonzero = np.flatnonzero(row)
        if len(nonzero) == 0:
            labels[index] = 0
            continue
        inverse = pow(int(row[nonzero[0]]), -1, prime)
        key = tuple(map(int, (row * inverse) % prime))
        labels[index] = keys.setdefault(key, len(keys) + 1)
    return rank, labels


def pair_orbit_representatives(stabilizer, pairs):
    if not pairs:
        return []
    domain = libgap([libgap.Set([left + 1, right + 1]) for left, right in pairs])
    orbits = libgap.OrbitsDomain(libgap(stabilizer), domain, libgap.OnSets)
    return [
        tuple(sorted(int(entry) - 1 for entry in orbit[0].sage()))
        for orbit in orbits
    ]


def raw_completion_candidates(
    selected,
    octads,
    relation,
    ambient_coordinates,
    determinant_bound,
):
    selected_set = set(selected)
    remaining = np.array(
        [index for index in range(759) if index not in selected_set], dtype=np.int64
    )
    prefix_gram = relation[np.ix_(selected, selected)]
    prefix_matrix = matrix(ZZ, prefix_gram.tolist())
    prefix_determinant = int(prefix_matrix.det())
    if prefix_determinant == 0:
        return [], {
            "prefix_determinant": 0,
            "positive_union_completions": 0,
            "raw_in_band_completions": 0,
            "modular_saturation_candidates": 0,
            "exact_saturation_candidates_before_stabilizer": 0,
        }

    adjugate = np.array(prefix_matrix.adjugate(), dtype=np.int64)
    pairings = relation[np.ix_(remaining, selected)]
    paired_adjugate = pairings @ adjugate
    alpha = 4 * prefix_determinant - np.einsum(
        "ij,ij->i", paired_adjugate, pairings
    )
    beta = (
        prefix_determinant * relation[np.ix_(remaining, remaining)]
        - paired_adjugate @ pairings.T
    )
    numerators = np.outer(alpha, alpha) - beta * beta
    upper = np.triu_indices(len(remaining), 1)
    assert np.all(numerators[upper] % prefix_determinant == 0)
    raw_determinants = numerators[upper] // prefix_determinant

    union = 0
    for index in selected:
        union |= octads[index]
    union_ok = np.fromiter(
        (
            (union | octads[remaining[left]] | octads[remaining[right]]).bit_count()
            >= 19
            for left, right in zip(*upper)
        ),
        dtype=bool,
        count=len(raw_determinants),
    )
    eligible = (raw_determinants > 0) & union_ok
    raw_in_band = eligible & (raw_determinants <= determinant_bound)

    # Hadamard gives det <= 4^7.  If saturation lowers an out-of-band raw
    # determinant into the band, its index has a prime divisor at most 127.
    square_potential = np.zeros(len(raw_determinants), dtype=bool)
    for divisor in range(2, 129):
        square = divisor * divisor
        square_potential |= (
            (raw_determinants % square == 0)
            & (raw_determinants // square <= determinant_bound)
        )
    square_potential &= eligible & ~raw_in_band

    modular_deficient = np.zeros(len(raw_determinants), dtype=bool)
    modular_by_prime = Counter()
    prefix_rows = ambient_coordinates[np.array(selected)]
    for prime in map(int, prime_range(2, 129)):
        relevant = square_potential & (raw_determinants % (prime * prime) == 0)
        if not relevant.any():
            continue
        rank, labels = quotient_projective_labels(
            prefix_rows, ambient_coordinates, prime
        )
        if rank < 5:
            deficient = relevant
        else:
            left_labels = labels[remaining[upper[0]]]
            right_labels = labels[remaining[upper[1]]]
            deficient = relevant & (
                (left_labels == 0)
                | (right_labels == 0)
                | (left_labels == right_labels)
            )
        count = int(deficient.sum())
        if count:
            modular_by_prime[prime] = count
            modular_deficient |= deficient

    exact_positions = np.flatnonzero(raw_in_band | modular_deficient)
    pairs = [
        (int(remaining[upper[0][position]]), int(remaining[upper[1][position]]))
        for position in exact_positions
    ]
    raw_by_pair = {pair: int(raw_determinants[position]) for pair, position in zip(pairs, exact_positions)}
    return (pairs, raw_by_pair), {
        "prefix_determinant": prefix_determinant,
        "positive_union_completions": int(eligible.sum()),
        "raw_in_band_completions": int(raw_in_band.sum()),
        "square_potential_out_of_band_completions": int(square_potential.sum()),
        "modular_saturation_candidates": int(modular_deficient.sum()),
        "modular_saturation_candidates_by_prime": {
            str(prime): count for prime, count in sorted(modular_by_prime.items())
        },
        "exact_saturation_candidates_before_stabilizer": len(pairs),
    }


def exact_record(selected, raw_determinant, octads, ambient_coordinates, ambient_gram):
    raw_basis = matrix(ZZ, ambient_coordinates[np.array(selected)].tolist())
    auxiliary_basis, closure_index = primitive_closure(raw_basis)
    auxiliary_gram = auxiliary_basis * ambient_gram * auxiliary_basis.transpose()
    determinant = int(auxiliary_gram.det())
    assert raw_determinant == determinant * closure_index * closure_index
    complement_basis = (auxiliary_basis * ambient_gram).right_kernel_matrix()
    frame_gram = complement_basis * ambient_gram * complement_basis.transpose()
    assert frame_gram.det() == determinant and frame_gram.is_positive_definite()
    union = 0
    for index in selected:
        union |= octads[index]
    uncovered = 24 - union.bit_count()
    root_shell = pari(frame_gram).qfminim(2)
    assert int(root_shell[0]) == 2 * uncovered
    return {
        "octad_indices_one_based": [index + 1 for index in selected],
        "octad_supports_one_based": [
            [coordinate + 1 for coordinate in range(24) if (octads[index] >> coordinate) & 1]
            for index in selected
        ],
        "coordinate_union_size": union.bit_count(),
        "raw_determinant": raw_determinant,
        "primitive_closure_index": closure_index,
        "determinant": determinant,
        "auxiliary_ambient_basis": rows(auxiliary_basis),
        "auxiliary_gram": rows(auxiliary_gram),
        "frame_ambient_basis": rows(complement_basis),
        "frame_gram": rows(frame_gram),
        "frame_root_system": "0" if uncovered == 0 else f"{uncovered}A1",
        "frame_root_rank": uncovered,
        "frame_signed_root_count": 2 * uncovered,
        "mordell_weil_rank": 17 - uncovered,
    }


def attach_ternary_gates(records):
    genera_by_determinant = {}
    match_cache = {}
    for record in records:
        frame = matrix(ZZ, record["frame_gram"])
        target = discriminant_form_key(Genus(frame))
        key = json.dumps(target, sort_keys=True)
        determinant = record["determinant"]
        if determinant not in genera_by_determinant:
            genera_by_determinant[determinant] = genera(
                (2, 1), determinant, even=True
            )
        if key not in match_cache:
            matches = [
                genus
                for genus in genera_by_determinant[determinant]
                if discriminant_form_key(genus) == target
            ]
            match_cache[key] = {
                "frame_discriminant_form_normal_key": target,
                "all_even_ternary_genera_at_determinant": len(
                    genera_by_determinant[determinant]
                ),
                "matching_even_ternary_genera": len(matches),
                "ternary_genus_representatives": [
                    rows(matrix(ZZ, genus.representative())) for genus in matches
                ],
            }
            for genus in matches:
                representative = matrix(ZZ, genus.representative())
                assert representative.det() == -determinant
                assert QuadraticForm(QQ, representative).signature() == 1
        record["k3_discriminant_gate"] = match_cache[key]


def enumerate_shard(prefix_payload, prefix_start, prefix_stop, determinant_bound):
    code, physical_basis, ambient_gram = construction_a_model()
    octads = sorted(mask(word) for word in code if word.hamming_weight() == 8)
    assert len(octads) == 759
    group = build_action(code, octads)
    group_gap = libgap(group)
    relation = np.array(
        [[(left & right).bit_count() // 2 for right in octads] for left in octads],
        dtype=np.int64,
    )
    inverse_physical_basis = physical_basis.inverse()
    ambient_coordinates = np.array(
        [octad_ambient_coordinates(value, inverse_physical_basis) for value in octads],
        dtype=np.int64,
    )
    prefixes = prefix_payload["layers"][-1]["orbits"]
    assert prefix_payload["layers"][-1]["size"] == 5
    assert 0 <= prefix_start < prefix_stop <= len(prefixes)

    prefix_records = []
    proposed = []
    totals = Counter()
    for prefix_index in range(prefix_start, prefix_stop):
        selected = tuple(
            entry - 1 for entry in prefixes[prefix_index]["octad_indices_one_based"]
        )
        candidate_payload, statistics = raw_completion_candidates(
            selected,
            octads,
            relation,
            ambient_coordinates,
            determinant_bound,
        )
        if candidate_payload:
            pairs, raw_by_pair = candidate_payload
            stabilizer = group.stabilizer(
                Set([entry + 1 for entry in selected]), action="OnSets"
            )
            pair_representatives = pair_orbit_representatives(stabilizer, pairs)
            statistics["pair_orbits_under_prefix_stabilizer"] = len(
                pair_representatives
            )
            for pair in pair_representatives:
                proposed.append(
                    (tuple(sorted(selected + pair)), raw_by_pair[pair], prefix_index)
                )
        else:
            statistics["pair_orbits_under_prefix_stabilizer"] = 0
        prefix_records.append({"prefix_index_zero_based": prefix_index, **statistics})
        totals.update(
            {
                key: value
                for key, value in statistics.items()
                if isinstance(value, int)
                and key != "prefix_determinant"
            }
        )
        if (prefix_index - prefix_start + 1) % 25 == 0:
            print(
                f"OCTADCOMPLETE|prefixes={prefix_index - prefix_start + 1}/"
                f"{prefix_stop - prefix_start}|proposed={len(proposed)}",
                flush=True,
            )

    buckets = defaultdict(list)
    retained = []
    exact_m24_duplicates = 0
    for selected, raw_determinant, prefix_index in proposed:
        signature = invariant_signature(selected, octads, relation)
        bucket = buckets[signature]
        prior = next(
            (item for item in bucket if equivalent(group_gap, selected, item[0])),
            None,
        )
        if prior is not None:
            exact_m24_duplicates += 1
            continue
        bucket.append((selected, raw_determinant, prefix_index))
        retained.append((selected, raw_determinant, prefix_index))

    records = []
    rejected_after_saturation = 0
    for selected, raw_determinant, prefix_index in retained:
        record = exact_record(
            selected, raw_determinant, octads, ambient_coordinates, ambient_gram
        )
        if record["determinant"] > determinant_bound:
            rejected_after_saturation += 1
            continue
        stabilizer_order = int(
            group.stabilizer(
                Set([entry + 1 for entry in selected]), action="OnSets"
            ).order()
        )
        record.update(
            {
                "source_prefix_index_zero_based": prefix_index,
                "m24_stabilizer_order": stabilizer_order,
                "m24_orbit_size": int(group.order()) // stabilizer_order,
            }
        )
        records.append(record)
    attach_ternary_gates(records)

    return {
        "schema": "elkies-k3.24a1-octad-rank7-completion-shard.v1",
        "status": "PASS_EXACT_DECLARED_24A1_OCTAD_COMPLETION_SHARD",
        "proof_scope": {
            "proved": (
                "For every exact M24 five-octad prefix orbit in the declared "
                "half-open index range, every two-octad completion with union "
                "size at least 19 is determinant-tested, saturated in N(24A1), "
                "and canonicalized first by the prefix stabilizer and then by "
                "an exact full-M24 transporter. Out-of-band raw spans that "
                "could enter the band after saturation are retained by exact "
                "modular rank gates."
            ),
            "not_proved": (
                "This shard is not the full five-prefix range and the seven-"
                "octad language is not proved to contain every primitive rank-"
                "seven auxiliary in N(24A1). Canonicalization here is under "
                "the residual M24 action on positive octad vectors; Weyl sign "
                "canonicalization in the full W(24A1) semidirect M24 action is "
                "not yet performed. Ternary output records matching genera, "
                "not a class enumeration of all ternary lattices."
            ),
        },
        "parameters": {
            "prefix_start_zero_based_inclusive": prefix_start,
            "prefix_stop_zero_based_exclusive": prefix_stop,
            "available_size_five_prefix_orbits": len(prefixes),
            "determinant_bound": determinant_bound,
            "minimum_coordinate_union_size": 19,
            "minimum_mordell_weil_rank": 12,
        },
        "group": {
            "name": "M24",
            "order": int(group.order()),
            "action_degree": 759,
            "weyl_sign_canonicalization": "OPEN_NOT_APPLIED_IN_THIS_SHARD",
        },
        "statistics": {
            "prefixes_processed": prefix_stop - prefix_start,
            "aggregate_prefix_counters": dict(sorted(totals.items())),
            "proposals_after_prefix_stabilizers": len(proposed),
            "invariant_buckets": len(buckets),
            "exact_m24_duplicate_proposals": exact_m24_duplicates,
            "m24_orbits_before_exact_saturation_band_gate": len(retained),
            "rejected_after_exact_saturation_band_gate": rejected_after_saturation,
            "retained_m24_orbits": len(records),
            "determinant_distribution": dict(
                sorted(Counter(record["determinant"] for record in records).items())
            ),
            "mordell_weil_rank_distribution": dict(
                sorted(Counter(record["mordell_weil_rank"] for record in records).items())
            ),
        },
        "prefix_records": prefix_records,
        "orbits": records,
    }


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--prefix", type=Path, default=DEFAULT_PREFIX)
parser.add_argument("--prefix-start", type=int, required=True)
parser.add_argument("--prefix-stop", type=int, required=True)
parser.add_argument("--determinant-bound", type=int, default=500)
parser.add_argument("--output", type=Path)
parser.add_argument("--check", action="store_true")
arguments = parser.parse_args()

prefix_bytes = arguments.prefix.read_bytes()
prefix_payload = json.loads(prefix_bytes)
result = enumerate_shard(
    prefix_payload,
    arguments.prefix_start,
    arguments.prefix_stop,
    arguments.determinant_bound,
)
result["input"] = {
    "prefix_artifact": str(arguments.prefix.relative_to(ROOT)),
    "prefix_artifact_sha256": hashlib.sha256(prefix_bytes).hexdigest(),
}
output = arguments.output or (
    ROOT
    / "artifacts/generated-results"
    / (
        "elkies-k3-24a1-octad-rank7-completion-"
        f"{arguments.prefix_start:05d}-{arguments.prefix_stop:05d}-v1.json"
    )
)
rendered = json.dumps(result, indent=2, sort_keys=True) + "\n"
if arguments.check:
    assert output.read_text() == rendered
else:
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(rendered)
print(
    f"OCTADCOMPLETE|prefixes={arguments.prefix_start}:{arguments.prefix_stop}"
    f"|orbits={result['statistics']['retained_m24_orbits']}"
    f"|status={result['status']}"
)
