P1x = (-1670928357567993296524435784100647303635608260375773169474282046928278539816343432016507007184397779661606680528192051834000653311764046875000/1307788530632614219394136861324995394471128053328091042895673445236887672568300817440189446986553718814841*j - 568482553228296038940362952896142289917346586313108682562247712626610878258539813676229428790905373378974551959133232582342774233514308203125/1307788530632614219394136861324995394471128053328091042895673445236887672568300817440189446986553718814841)*S^4 + (-*j - )*S^3 + (*j - )*S^2 + (*j - )*S + *j + 
P1y = (*j + )*S^6 + (-*j + )*S^5 + (-*j + )*S^4 + (-*j - )*S^3 + (-*j - )*S^2 + (*j - )*S + *j + 
Hx = (1053530279333147121643494585369961341091845521706702047913701281655821628311079837303996253868686763475984103561977608337202105099648445312500/1307788530632614219394136861324995394471128053328091042895673445236887672568300817440189446986553718814841*j + 783452553512639073773378114155664590543122807147391281127868551717443705865882489755076290774610493487210982020946835577976038483228230859375/1307788530632614219394136861324995394471128053328091042895673445236887672568300817440189446986553718814841)*S^4 + (*j + )*S^3 + (-*j + )*S^2 + (-*j - )*S + *j - 
Hy = (*j + )*S^6 + (-*j + )*S^5 + (-*j + )*S^4 + (-*j - )*S^3 + (*j - )*S^2 + (*j + )*S - *j + 
