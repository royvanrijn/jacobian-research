#!/usr/bin/env sage
from sage.all import PolynomialRing, QuadraticField
K = QuadraticField(-3, "j")
j = K.gen()
R = PolynomialRing(K, "V")
V = R.gen()
d = -10667231385231072882244397377881751841146388623382483881662469517030070513371672204475582675407583950973946958813551024753207096047416642522625/131234250688050175362554288936281798870746282833921699925135887201407712881670679892891544385387999845375975970940611745301543193389574125182554632*j + 35096754960411298066605494399067292974838799613822039542138842776745607012871612736328729686004035218919176485396148373404958004717253974048625/131234250688050175362554288936281798870746282833921699925135887201407712881670679892891544385387999845375975970940611745301543193389574125182554632
A = (*j + )*V^8 + (-*j - )*V^7 + (*j - )*V^6 + (-*j - )*V^5 + (*j - )*V^4 + (-*j + )*V^3 + (-*j - )*V^2 + (*j + )*V + *j + 
B = (-*j + )*V^12 + (*j - )*V^11 + (*j + )*V^10 + (-*j + )*V^9 + (-*j - )*V^8 + (*j + )*V^7 + (-*j + )*V^6 + (*j - )*V^5 + (*j + )*V^4 + (-*j - )*V^3 + (*j - )*V^2 + (*j - )*V - *j - 
Delta = -16*(4*A^3+27*B^2)
assert Delta.degree() == 24
print(f"Q80ORBIT1222JACOBIAN|d={d}|field=QQ(sqrt(-3))|status=PASS_EXACT_TWIST")
