#!/usr/bin/env sage-python
"""Verify the blind curve-398 MW16 discovery against the held-out rank-30 group.

This post-search verifier is deliberately separate from the blind runner.  It
loads the public point list and recovered-fibration truth only after the search
has stopped, extends the primitive generic MW16 coordinate rows to a unimodular
basis of the public rank-30 lattice, and treats the resulting fourteen points
as the held-out complement.  Exact height-dual coordinates and rational group
law prove that the blind rank-30 basis contains every held-out point and equals
the subgroup generated by all thirty public points.
"""

from __future__ import annotations

import argparse
from collections import Counter
from fractions import Fraction
from hashlib import sha256
from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import sys

from sage.all import ZZ, block_diagonal_matrix, identity_matrix, matrix


ROOT = Path(__file__).resolve().parents[2]
BLIND_INPUT = ROOT / "elliptic-curves/data/icarm_curve398_mw16_blind_input_v1.json"
BLIND_RESULT = ROOT / "artifacts/generated-results/elliptic-curves/curve398_mw16_adaptive_half_lattice_blind_v1.json"
TRUTH = ROOT / "artifacts/generated-results/elliptic-curves/icarm_curve398_hidden_a1_mw16_v1.json"
PUBLIC = ROOT / "elliptic-curves/cas/icarm_curve398.py"
RUNNER = ROOT / "elliptic-curves/cas/run_curve398_mw16_adaptive_half_lattice_search.sage"
OUTPUT = ROOT / "artifacts/generated-results/elliptic-curves/curve398_mw16_adaptive_half_lattice_verification_v1.json"


def digest(path: Path) -> str:
    return sha256(path.read_bytes()).hexdigest()


def relative(path: Path) -> str:
    return str(path.resolve().relative_to(ROOT))


def read_point(record):
    return Fraction(record["x"]), Fraction(record["y"])


def point_record(point):
    return {"x": str(point[0]), "y": str(point[1])}


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, default=OUTPUT)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()

    sys.path.insert(0, str(ROOT / "elliptic-curves"))
    from latent_lattice.elliptic import EllipticCurve
    from latent_lattice.pari import recover_exact_embedding, row_embedding_smith_invariant_factors

    public = SourceFileLoader("curve398_verification_public", str(PUBLIC)).load_module()
    input_document = json.loads(BLIND_INPUT.read_text())
    blind = json.loads(BLIND_RESULT.read_text())
    truth = json.loads(TRUTH.read_text())
    if blind.get("status") != "STOPPED_AT_DECLARED_LIFT_LIMIT":
        raise ArithmeticError("blind run did not stop at its declared post-rank-30 lift bound")
    if blind["blindness_boundary"]["public_rank30_fixture_loaded"] is not False:
        raise ArithmeticError("blind run crossed the public-fixture boundary")
    if blind["input_hashes"][relative(BLIND_INPUT)] != digest(BLIND_INPUT):
        raise ArithmeticError("blind input hash does not replay")
    if truth.get("status") != "PASS_EXACT_HIDDEN_A1_MW16_FIBRATION_PARAMETER_AND_PUBLIC_SUBGROUP":
        raise ArithmeticError("hidden-fibration truth is not exact")

    initial = blind["initial_search"]
    adaptive = blind["iterations"]
    if initial["basis_rank_before"] != 16 or initial["basis_rank_after"] != 21:
        raise ArithmeticError("generic-deepest transition is no longer M16 to M21")
    if len(adaptive) != 1 or adaptive[0]["basis_rank_before"] != 21 or adaptive[0]["basis_rank_after"] != 30:
        raise ArithmeticError("adaptive transition is no longer M21 to M30")
    if Counter(event["type"] for event in initial["discovered_group_saturation"]["events"]) != Counter({"NEW_Q_INDEPENDENT_DIRECTION": 5}):
        raise ArithmeticError("initial independent-gain count changed")
    if Counter(event["type"] for event in adaptive[0]["discovered_group_saturation"]["events"]) != Counter({"NEW_Q_INDEPENDENT_DIRECTION": 9}):
        raise ArithmeticError("adaptive independent-gain count changed")
    all_searches = initial["cover_records"] + adaptive[0]["cover_records"]
    if len(all_searches) != 384 or any(row["search"]["status"] != "bounded_search_complete" for row in all_searches):
        raise ArithmeticError("not all 384 declared blind charts completed")

    model = tuple(Fraction(value) for value in input_document["short_model"])
    curve = EllipticCurve(model)
    generic = tuple(read_point(record) for record in input_document["generic_points"])
    blind_basis = tuple(read_point(record) for record in blind["current_basis"])
    public_short = tuple(
        (Fraction(str(point[0])), Fraction(str(point[1])))
        for point in public.SHORT_POINTS
    )
    if len(generic) != 16 or len(blind_basis) != 30 or len(public_short) != 30:
        raise ArithmeticError("curve-398 verification dimensions changed")
    if any(not curve.is_on_curve(point) for point in (*generic, *blind_basis, *public_short)):
        raise ArithmeticError("verification input contains an off-curve point")

    generic_columns = truth["public_rank30_embedding"]["matrix_30_by_16_columns"]
    if tuple(row_embedding_smith_invariant_factors(generic_columns)) != (1,) * 16:
        raise ArithmeticError("generic MW16 embedding is not primitive in the public lattice")
    for point, column in zip(generic, generic_columns):
        if curve.linear_combination(public_short, column) != point:
            raise ArithmeticError("generic/public embedding failed independent exact replay")

    # Smith completion with the original sixteen rows fixed.  If U*A*V=[I 0],
    # then blockdiag(U^-1,I)*V^-1 is unimodular and begins literally with A.
    generic_matrix = matrix(ZZ, generic_columns)
    smith, left, right = generic_matrix.smith_form(transformation=True)
    if left * generic_matrix * right != smith or any(smith[i, i] != 1 for i in range(16)):
        raise ArithmeticError("generic embedding Smith form changed")
    completion = block_diagonal_matrix(left.inverse(), identity_matrix(ZZ, 14)) * right.inverse()
    if completion[:16] != generic_matrix or abs(completion.det()) != 1:
        raise ArithmeticError("failed to extend generic MW16 to a public unimodular basis")
    heldout_rows = tuple(tuple(map(int, row)) for row in completion.rows()[16:])
    heldout_points = tuple(curve.linear_combination(public_short, row) for row in heldout_rows)
    if any(point is None or not curve.is_on_curve(point) for point in heldout_points):
        raise ArithmeticError("a held-out complement point failed exact construction")

    heldout_in_blind = recover_exact_embedding(
        curve, blind_basis, heldout_points, digits=150, timeout=300.0
    )
    public_in_blind = recover_exact_embedding(
        curve, blind_basis, public_short, digits=150, timeout=300.0
    )
    blind_in_public = recover_exact_embedding(
        curve, public_short, blind_basis, digits=150, timeout=300.0
    )
    if len(heldout_in_blind.columns) != 14 or len(public_in_blind.columns) != 30 or len(blind_in_public.columns) != 30:
        raise ArithmeticError("subgroup containment embeddings have the wrong shape")

    payload = {
        "schema": "elliptic-curves.curve398-mw16-adaptive-half-lattice-verification.v1",
        "status": "PASS_EXACT_CROSS_FIBRATION_RANK30_REDISCOVERY",
        "curve_id": 398,
        "blind_transition": {
            "generic_rank": 16,
            "after_complete_generic_deepest_search": 21,
            "after_complete_five_bit_adaptive_wave": 30,
            "initial_independent_directions": 5,
            "adaptive_independent_directions": 9,
            "completed_bounded_charts": len(all_searches),
            "timeouts": 0,
            "final_stop": blind["stop"],
        },
        "heldout_complement": {
            "definition": "last fourteen rows of a unimodular completion whose first sixteen rows are the generic MW16 embedding in the ordered public rank-30 basis",
            "count": 14,
            "coordinate_rows_in_public_rank30_basis": [list(row) for row in heldout_rows],
            "points_on_curve398_short_model": [point_record(point) for point in heldout_points],
            "coordinates_in_blind_discovered_rank30_basis": [list(column) for column in heldout_in_blind.columns],
            "all_rediscovered": True,
            "exact_group_law_replay": True,
        },
        "subgroup_equality": {
            "blind_basis_rank": 30,
            "public_basis_rank": 30,
            "all_public_points_in_blind_group": True,
            "all_blind_basis_points_in_public_group": True,
            "blind_group_equals_public_rank30_subgroup": True,
            "public_in_blind_maximum_absolute_coordinate": public_in_blind.max_abs_coordinate,
            "blind_in_public_maximum_absolute_coordinate": blind_in_public.max_abs_coordinate,
            "exact_group_law_replay_both_directions": True,
        },
        "blindness_audit": {
            "search_input": relative(BLIND_INPUT),
            "search_input_contains_heldout_coordinates": False,
            "search_input_contains_public_embedding": False,
            "truth_and_public_fixture_first_loaded_by": relative(Path(__file__)),
            "verification_is_post_search": True,
        },
        "inputs": {
            relative(path): digest(path)
            for path in (BLIND_INPUT, BLIND_RESULT, TRUTH, PUBLIC, RUNNER, Path(__file__))
        },
        "claim_boundary": (
            "This proves that the bounded blind algorithm regenerated the complete displayed public rank-30 subgroup from the generic MW16 subgroup. "
            "It does not prove rank exactly 30, saturation in E(Q), or success on unseen curves without calibration."
        ),
        "reproducing_command": "sage -python elliptic-curves/cas/verify_curve398_mw16_adaptive_half_lattice_search.sage --check",
    }
    rendered = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    if args.check:
        if args.output.read_text() != rendered:
            raise ArithmeticError("stored curve-398 blind verification differs from replay")
    else:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered)
    print(
        f"C398MW16VERIFY|transition=16->21->30|heldout=14/14|"
        f"subgroup=PUBLIC_RANK30|status={payload['status']}|output={relative(args.output)}",
        flush=True,
    )


if __name__ == "__main__":
    main()
