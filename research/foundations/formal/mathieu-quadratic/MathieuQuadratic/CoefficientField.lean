import MathieuQuadratic.Laurent
import Mathlib.Algebra.MonoidAlgebra.MapDomain
import Mathlib.Analysis.Complex.Cardinality
import Mathlib.Analysis.Complex.Polynomial.Basic
import Mathlib.FieldTheory.IsAlgClosed.Classification

/-!
# Coefficient-field transfer for Laurent purity

Only the field generated by the coefficients of one Laurent polynomial is
embedded into the complex numbers. Its constant terms and support are
transported through the resulting coefficient embeddings.
-/

open Cardinal

namespace MathieuQuadratic

variable {F G : Type*} [Field F] [CharZero F] [AddCommGroup G]

private theorem exists_complex_embedding [Countable F] : Nonempty (F →+* ℂ) := by
  obtain ⟨ι, x, hx⟩ := exists_isTranscendenceBasis' ℚ F
  obtain ⟨κ, y, hy⟩ := exists_isTranscendenceBasis' ℚ ℂ
  haveI : Countable ι := hx.1.injective.countable
  have hC : ℵ₀ < #ℂ := by rw [Cardinal.mk_complex]; exact cantor _
  have hκ : ℵ₀ ≤ #κ := le_of_lt (by
    rwa [← IsAlgClosed.cardinal_eq_cardinal_transcendence_basis_of_aleph0_lt' y hy
      (Cardinal.mk_le_aleph0 (α := ℚ)) hC])
  letI : Infinite κ := Cardinal.aleph0_le_mk_iff.mp hκ
  obtain ⟨toNat⟩ := countable_iff_nonempty_embedding.mp (show Countable ι from inferInstance)
  let e : ι ↪ κ := toNat.trans (Infinite.natEmbedding κ)
  have hy' := hy.1.comp e e.injective
  let A := Algebra.adjoin ℚ (Set.range x)
  let f : A →ₐ[ℚ] ℂ :=
    (MvPolynomial.aeval (y ∘ e)).comp hx.1.aevalEquiv.symm.toAlgHom
  letI : Algebra A ℂ := f.toRingHom.toAlgebra
  haveI : Module.IsTorsionFree A ℂ :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr
      ((show Function.Injective (MvPolynomial.aeval (R := ℚ) (y ∘ e)) from hy').comp
        hx.1.aevalEquiv.symm.injective)
  letI : Algebra.IsAlgebraic A F := hx.isAlgebraic
  exact ⟨(IsAlgClosed.lift (R := A) (S := F) (M := ℂ)).toRingHom⟩

omit [CharZero F] in
private theorem support_mapRingHom_eq {L : Type*} [Field L] (f : F →+* L)
    (p : AddMonoidAlgebra F G) :
    (AddMonoidAlgebra.mapRingHom G f p).coeff.support = p.coeff.support := by
  classical
  ext g
  simp only [Finsupp.mem_support_iff, AddMonoidAlgebra.coeff_mapRingHom,
    ne_eq, map_eq_zero_iff _ (RingHom.injective f)]

omit [CharZero F] in
private theorem pure_mapRingHom_iff {L : Type*} [Field L] (f : F →+* L)
    (p : AddMonoidAlgebra F G) :
    Pure laurentCT (AddMonoidAlgebra.mapRingHom G f p) ↔ Pure laurentCT p := by
  have he (n : ℕ) :
      laurentCT (AddMonoidAlgebra.mapRingHom G f p ^ n) = f (laurentCT (p ^ n)) := by
    rw [← map_pow]
    exact AddMonoidAlgebra.coeff_mapRingHom f (p ^ n) 0
  simp only [Pure, he, map_eq_zero_iff _ (RingHom.injective f)]

omit [CharZero F] in
private theorem separator_from_coefficient_lift {E : Type*} [Field E]
    (down : E →+* F) (up : E →+* ℂ) (q : AddMonoidAlgebra E G)
    (complex : LaurentSeparation ℂ G) (hp : Pure laurentCT (AddMonoidAlgebra.mapRingHom G down q)) :
    ∃ ℓ : G →+ ℤ,
      ∀ g ∈ (AddMonoidAlgebra.mapRingHom G down q).coeff.support, 0 < ℓ g := by
  have hq := (pure_mapRingHom_iff down q).1 hp
  obtain ⟨ℓ, hℓ⟩ := complex _ ((pure_mapRingHom_iff up q).2 hq)
  refine ⟨ℓ, ?_⟩
  rw [support_mapRingHom_eq down q]
  rw [support_mapRingHom_eq up q] at hℓ
  exact hℓ

set_option maxHeartbeats 1000000 in
/-- The complex Laurent necessity theorem implies its characteristic-zero
version by embedding the field generated by the finitely many coefficients. -/
theorem laurentSeparation_of_complex (complex : LaurentSeparation ℂ G) :
    LaurentSeparation F G := by
  classical
  intro p hp
  let s : Set F := Set.range (fun g : p.coeff.support ↦ p.coeff g)
  let E := IntermediateField.adjoin ℚ s
  have countable_s : s.Countable := Set.countable_range _
  have hcard : Cardinal.lift #E ≤ ℵ₀ := by
    refine (IntermediateField.lift_cardinalMk_adjoin_le ℚ s).trans ?_
    exact sup_le (sup_le (by simp) (by simp)) le_rfl
  letI : Countable E := Cardinal.mk_le_aleph0_iff.mp
    (Cardinal.lift_le.mp (by simpa only [Cardinal.lift_aleph0] using hcard))
  obtain ⟨embed⟩ := exists_complex_embedding (F := E)
  have hcoef (g : G) : p.coeff g ∈ E := by
    by_cases hg : g ∈ p.coeff.support
    · exact IntermediateField.subset_adjoin ℚ s ⟨⟨g, hg⟩, rfl⟩
    · rw [Finsupp.notMem_support_iff.mp hg]
      exact E.zero_mem
  let q : AddMonoidAlgebra E G :=
    .ofCoeff (Finsupp.onFinset p.coeff.support (fun g ↦ ⟨p.coeff g, hcoef g⟩)
      fun g hg ↦ Finsupp.mem_support_iff.mpr fun hz ↦ hg (Subtype.ext hz))
  have he : AddMonoidAlgebra.mapRingHom G E.subtype q = p := by
    ext g
    rw [AddMonoidAlgebra.coeff_mapRingHom]
    rfl
  rw [← he] at hp ⊢
  exact separator_from_coefficient_lift (F := F) (E := E) (G := G) E.subtype embed q complex hp

end MathieuQuadratic
