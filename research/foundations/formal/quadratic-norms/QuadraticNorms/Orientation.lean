import Mathlib.Algebra.BigOperators.Group.Finset.Piecewise
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import Mathlib.GroupTheory.OrderOfElement

open scoped BigOperators

namespace QuadraticNorms

variable {G ι : Type*} [AddCommGroup G] [Fintype ι]

/-- All sums of independent choices in the cyclic subgroups generated by f. -/
private def orientationShifts (f : ι → G) : AddSubgroup G where
  carrier := {x | ∃ s : ι → G, (∀ i, s i ∈ AddSubgroup.zmultiples (f i)) ∧ ∑ i, s i = x}
  zero_mem' := ⟨fun _ => 0, fun _ => AddSubgroup.zero_mem _, by simp⟩
  add_mem' := by
    rintro x y ⟨s, hs, rfl⟩ ⟨t, ht, rfl⟩
    exact ⟨fun i => s i + t i, fun i => AddSubgroup.add_mem _ (hs i) (ht i), Finset.sum_add_distrib⟩
  neg_mem' := by
    rintro x ⟨s, hs, rfl⟩
    exact ⟨fun i => -s i, fun i => AddSubgroup.neg_mem _ (hs i), Finset.sum_neg_distrib _⟩

private theorem closure_le_orientationShifts (f : ι → G) :
    AddSubgroup.closure (Set.range f) ≤ orientationShifts f := by
  classical
  apply (AddSubgroup.closure_le _).mpr
  rintro _ ⟨j, rfl⟩
  refine ⟨fun i => if i = j then f i else 0, ?_, by simp⟩
  intro i
  dsimp only
  split
  · exact AddSubgroup.mem_zmultiples _
  · exact AddSubgroup.zero_mem _

private theorem cyclic_shift [Finite G] (g x : G) (hx : x ∈ AddSubgroup.zmultiples g) :
    ∃ k : ℕ, k < addOrderOf g ∧ k • g = x := by
  obtain ⟨z, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
  have ho : 0 < (addOrderOf g : ℤ) := by exact_mod_cast addOrderOf_pos g
  have hz := Int.emod_nonneg z ho.ne'
  have hlt := Int.emod_lt_of_pos z ho
  refine ⟨(z % (addOrderOf g : ℤ)).toNat, by omega, ?_⟩
  rw [← natCast_zsmul, Int.toNat_of_nonneg hz, mod_addOrderOf_zsmul]

/-- Reversing between zero and order(2g)−1 orientations from each
independent family realizes every shift in the subgroup generated by
the doubled classes. This is the group calculation in the saturation
argument for the common-field theorem. -/
theorem class_of_independent_orientation_choices [Finite G] (g : ι → G) {a c : G}
    (h : c - a ∈ AddSubgroup.closure (Set.range fun i => (2 : ℕ) • g i)) :
    ∃ j : ι → ℕ, (∀ i, j i < addOrderOf ((2 : ℕ) • g i)) ∧
      a + ∑ i, -(j i • ((2 : ℕ) • g i)) = c := by
  classical
  have hmem := closure_le_orientationShifts (fun i => (2 : ℕ) • g i) h
  obtain ⟨s, hs, heq⟩ := hmem
  choose j hj hval using fun i => cyclic_shift _ _ (AddSubgroup.neg_mem _ (hs i))
  refine ⟨j, hj, ?_⟩
  simp_rw [hval, neg_neg]
  rw [heq, add_sub_cancel]

end QuadraticNorms
