{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/elkies_k3_process_ledger.schema.json",
  "title": "Elkies K3 mathematical process ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status_authority",
    "purpose",
    "time_provenance",
    "global_invariants",
    "stages",
    "transitions",
    "events",
    "mechanisms",
    "literature"
  ],
  "properties": {
    "schema": {"const": "elkies-k3.process-ledger.v1"},
    "status_authority": {"const": "MATH_STATUS.json"},
    "purpose": {"type": "string", "minLength": 1},
    "time_provenance": {
      "type": "object",
      "required": ["priority", "warning"],
      "properties": {
        "priority": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "warning": {"type": "string", "minLength": 1}
      }
    },
    "global_invariants": {
      "type": "object",
      "required": [
        "generic_picard_rank",
        "generic_ns_absolute_discriminant",
        "generic_shioda_tate_budget",
        "cm24_picard_rank",
        "cm24_shioda_tate_budget",
        "rank_balance_formula"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/transition"}
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mechanism"}
    },
    "literature": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^LIT-"},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "label", "ade", "root_rank", "mw_rank", "picard_rank", "scope", "status", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "route": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "ade": {"type": "string", "minLength": 1},
        "root_rank": {"type": "integer", "minimum": 0},
        "mw_rank": {"type": "integer", "minimum": 0},
        "picard_rank": {"type": "integer", "minimum": 2, "maximum": 22},
        "ns_discriminant": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["generic", "cm24-specialization"]},
        "status": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "from", "to", "operation", "q", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "route": {"type": "string", "minLength": 1},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "operation": {"enum": ["elliptic-neighbor", "specialized-neighbor"]},
        "q": {"type": "integer", "minimum": 1},
        "factorization": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "old_fiber_degree": {"type": "integer", "minimum": 1},
        "orbit": {"type": ["integer", "null"], "minimum": 0},
        "search_scope": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observed_at", "time_basis", "phase", "behavior", "method", "meaning", "generalization", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^EV[0-9]{2}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "time_basis": {"enum": ["git_commit_time", "imported_artifact_mtime", "dated_note"]},
        "artifact_globs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "phase": {"type": "string", "minLength": 1},
        "behavior": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "generalization": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "symptom", "resolution", "meaning", "generalization", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^MECH-[0-9]{2}$"},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "symptom": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "generalization": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
