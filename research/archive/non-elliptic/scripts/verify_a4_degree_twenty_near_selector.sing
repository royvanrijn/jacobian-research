// Verify the genera of the one-jet near-selector and its exact correction.

LIB "normal.lib";
LIB "absfact.lib";

ring root_ring=0,(T,a,b),dp;

poly B=
    a^3-3*a*b^2+2*b^3-9*a*b+9*b^2-27*a+27*b+27;
poly A=a^3-b^3-9*b^2-27*b-54;
poly C=a^3-b^3+27;
poly P=
    T^4
    -6*A*B*T^2
    -8*B^3*T
    +B^2*(9*A^2-12*C*B);
poly J=(b+6)*T-81*(b^2+3*b+9);
poly normJ=resultant(P,J,T);

ring coefficient_ring=0,(a,b),dp;
poly normJ=imap(root_ring,normJ);

if (deg(normJ)!=16 || size(factorize(normJ,1))!=1)
{
    ERROR("the near-selector norm is not irreducible of degree 16");
}
if (genus(ideal(normJ))!=10)
{
    ERROR("the near-selector norm does not have genus 10");
}

def absolute_ring=absFactorize(normJ);
setring absolute_ring;
if (absolute_factors[4]!=1)
{
    ERROR("the near-selector norm is not absolutely irreducible");
}

print("PASS: the degree-16 near-selector norm is absolutely irreducible of genus 10");

ring chart_ring=0,(U,V),dp;

poly H=
    8*U^3-6*U*V^2-18*U*V-54*U
    -2*V^3-9*V^2-27*V-27;
poly K=4*U^2+4*U*V+6*U+V^2+3*V+9;
poly M=U^2+2*V^2+6*V+18;
poly L=
    U^3-3*U*V^2-9*U*V-27*U
    +2*V^3+9*V^2+27*V+27;
poly N1=M*K;
poly N2=
    8*U^3*V+12*U^2*V^2+36*U^2*V+108*U^2
    +6*U*V^3+36*U*V^2+108*U*V+162*U
    +V^4+9*V^3+27*V^2+54*V;
poly Astar=U^3-V^3-9*V^2-27*V-54;
poly rootNumerator=3*Astar*K^3*L;

poly rhoNumerator=N2^2+3*N2*H+9*H^2;
poly nearNumerator=
    (N2+6*H)*rootNumerator-81*rhoNumerator*H^2;
poly correctionNumerator=
    9*N1*N2^2+27*N1*N2*H-162*N1*H^2
    -8*N2^3-36*N2^2*H-108*N2*H^2-108*H^3;
poly jetNumerator=
    36*nearNumerator*H^2
    +(2*N2+3*H)*rhoNumerator*correctionNumerator;
poly residual18=jetNumerator/K^3;

if (jetNumerator-K^3*residual18!=0 || deg(residual18)!=18)
{
    ERROR("the corrected-selector strict quotient is not exact of degree 18");
}
if (size(factorize(residual18,1))!=1)
{
    ERROR("the corrected-selector strict curve is not irreducible");
}
if (genus(ideal(residual18))!=31)
{
    ERROR("the corrected-selector strict curve does not have genus 31");
}

def residual_absolute_ring=absFactorize(residual18);
setring residual_absolute_ring;
if (absolute_factors[4]!=1)
{
    ERROR("the corrected-selector strict curve is not absolutely irreducible");
}

print("PASS: the exact rho-corrected selector has an absolute genus-31 strict curve");
