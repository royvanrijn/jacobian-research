  "internal_pdf_review": {
    "title": "Ordinary knot-group and branched-cover ranks from hyperbolic symmetry",
    "reviewed_pdf": ".scratch/mrc-fox-frontier/rank-symmetry-build/ORDINARY_RANK_FROM_HYPERBOLIC_SYMMETRY.pdf",
